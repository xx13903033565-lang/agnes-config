ng"},"center":{"description":"Optional center point","$ref":"#/$defs/MapCenter"},"zoom":{"description":"Optional initial zoom level","type":"number","format":"double"},"clustering":{"description":"Optional boolean to enable/disable clustering","type":"boolean"},"clusterRadius":{"description":"Optional cluster radius","type":"number","format":"double"},"autoFit":{"description":"Optional boolean to auto-fit map to markers","type":"boolean"}},"required":["markers"]},"MapMarker":{"description":"Map marker structure","type":"object","properties":{"lat":{"description":"Latitude (required)","type":"number","format":"double"},"lng":{"description":"Longitude (required)","type":"number","format":"double"},"name":{"description":"Location name","type":"string"},"value":{"description":"Numeric value for sizing/coloring","type":"number","format":"double"},"description":{"description":"Description text","type":"string"},"popup":{"description":"Custom popup HTML","type":"string"},"color":{"description":"Custom marker color","type":"string"},"label":{"description":"Custom marker label","type":"string"},"useDefaultIcon":{"description":"Use default Leaflet icon","type":"boolean"}},"required":["lat","lng"]},"MapCenter":{"description":"Map center point","type":"object","properties":{"lat":{"description":"Latitude","type":"number","format":"double"},"lng":{"description":"Longitude","type":"number","format":"double"}},"required":["lat","lng"]}},"required":["data"],"type":"object","properties":{"data":{"description":"The data for the map visualization","$ref":"#/$defs/MapData"}}}}},{"type":"function","function":{"name":"autovisualiser__render_mermaid","description":"show a Mermaid diagram from Mermaid syntax\n\nProvide the Mermaid code as a string. Supports flowcharts, sequence diagrams, Gantt charts, etc.\n\nExample:\ngraph TD;\n    A-->B;\n    A-->C;\n    B-->D;\n    C-->D;\n","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","required":["mermaid_code"],"properties":{"mermaid_code":{"description":"The Mermaid diagram code to render","type":"string"}},"type":"object"}}},{"type":"function","function":{"name":"autovisualiser__render_radar","description":"show a radar chart (spider chart) for multi-dimensional data comparison\n\nThe data must contain:\n- labels: Array of strings representing the dimensions/axes\n- datasets: Array of dataset objects with 'label' and 'data' properties\n\nExample:\n{\n  \"labels\": [\"Speed\", \"Strength\", \"Endurance\", \"Agility\", \"Intelligence\"],\n  \"datasets\": [\n    {\n      \"label\": \"Player 1\",\n      \"data\": [85, 70, 90, 75, 80]\n    },\n    {\n      \"label\": \"Player 2\",\n      \"data\": [75, 85, 80, 90, 70]\n    }\n  ]\n}","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"RadarData":{"description":"Radar chart data structure","type":"object","properties":{"labels":{"description":"Category labels","type":"array","items":{"type":"string"}},"datasets":{"description":"Datasets to compare","type":"array","items":{"$ref":"#/$defs/RadarDataset"}}},"required":["labels","datasets"]},"RadarDataset":{"description":"Radar dataset structure","type":"object","properties":{"label":{"description":"Label for this dataset","type":"string"},"data":{"description":"Data values for each category","type":"array","items":{"type":"number","format":"double"}}},"required":["label","data"]}},"required":["data"],"type":"object","properties":{"data":{"description":"The data for the radar chart","$ref":"#/$defs/RadarData"}}}}},{"type":"function","function":{"name":"autovisualiser__render_sankey","description":"show a Sankey diagram from flow data\nThe data must contain:\n- nodes: Array of objects with 'name' and optional 'category' properties\n- links: Array of objects with 'source', 'target', and 'value' properties\n\nIMPORTANT: Links must NOT form cycles (e.g. A→B and B→A). Sankey diagrams are\ndirectional acyclic flows. If the data has circular relationships, restructure\nthem so flow moves in one direction (e.g. add a separate node like \"Re-signed\"\ninstead of linking back to an earlier node).\n\nExample:\n{\n  \"nodes\": [\n    {\"name\": \"Source A\", \"category\": \"source\"},\n    {\"name\": \"Target B\", \"category\": \"target\"}\n  ],\n  \"links\": [\n    {\"source\": \"Source A\", \"target\": \"Target B\", \"value\": 100}\n  ]\n}","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"SankeyData":{"description":"Sankey data structure","type":"object","properties":{"nodes":{"description":"Array of nodes","type":"array","items":{"$ref":"#/$defs/SankeyNode"}},"links":{"description":"Array of links between nodes","type":"array","items":{"$ref":"#/$defs/SankeyLink"}}},"required":["nodes","links"]},"SankeyNode":{"description":"Sankey node structure","type":"object","properties":{"name":{"description":"The name of the node","type":"string"},"category":{"description":"Optional category for the node","type":"string"}},"required":["name"]},"SankeyLink":{"description":"Sankey link structure","type":"object","properties":{"source":{"description":"Source node name","type":"string"},"target":{"description":"Target node name","type":"string"},"value":{"description":"Flow value","type":"number","format":"double"}},"required":["source","target","value"]}},"required":["data"],"type":"object","properties":{"data":{"description":"The data for the Sankey diagram","$ref":"#/$defs/SankeyData"}}}}},{"type":"function","function":{"name":"autovisualiser__render_treemap","description":"show a treemap visualization for hierarchical data with proportional area representation as boxes\n\nThe data should be a hierarchical structure with:\n- name: Name of the node (required)\n- value: Numeric value for leaf nodes (optional for parent nodes)\n- children: Array of child nodes (optional)\n- category: Category for coloring (optional)\n\nExample:\n{\n  \"name\": \"Root\",\n  \"children\": [\n    {\n      \"name\": \"Group A\",\n      \"children\": [\n        {\"name\": \"Item 1\", \"value\": 100, \"category\": \"Type1\"},\n        {\"name\": \"Item 2\", \"value\": 200, \"category\": \"Type2\"}\n      ]\n    },\n    {\"name\": \"Item 3\", \"value\": 150, \"category\": \"Type1\"}\n  ]\n}","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"TreemapNode":{"description":"Treemap node structure","type":"object","properties":{"name":{"description":"Name of the node","type":"string"},"value":{"description":"Value for leaf nodes","type":"number","format":"double"},"category":{"description":"Category for coloring","type":"string"},"children":{"description":"Children nodes","type":"array","items":{"$ref":"#/$defs/TreemapNode"}}},"required":["name"]}},"required":["data"],"type":"object","properties":{"data":{"description":"The hierarchical data for the treemap","$ref":"#/$defs/TreemapNode"}}}}},{"type":"function","function":{"name":"autovisualiser__show_chart","description":"show interactive line, scatter, or bar charts\n\nRequired: type ('line', 'scatter', or 'bar'), datasets array\nOptional: labels, title, subtitle, xAxisLabel, yAxisLabel, options\n\nExample:\n{\n  \"type\": \"line\",\n  \"title\": \"Monthly Sales\",\n  \"labels\": [\"Jan\", \"Feb\", \"Mar\"],\n  \"datasets\": [\n    {\"label\": \"Product A\", \"data\": [65, 59, 80]}\n  ]\n}","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"ChartData":{"description":"Chart data structure","type":"object","properties":{"type":{"description":"Chart type. Chart type enumeration. One of: line: Line chart; scatter: Scatter chart; bar: Bar chart","type":"string","enum":["line","scatter","bar"]},"datasets":{"description":"Datasets to display","type":"array","items":{"$ref":"#/$defs/ChartDataset"}},"labels":{"description":"Optional labels for x-axis (for line/bar charts)","type":"array","items":{"type":"string"}},"title":{"description":"Optional chart title","type":"string"},"subtitle":{"description":"Optional subtitle","type":"string"},"xAxisLabel":{"description":"Optional x-axis label","type":"string"},"yAxisLabel":{"description":"Optional y-axis label","type":"string"}},"required":["type","datasets"]},"ChartDataset":{"description":"Chart dataset structure","type":"object","properties":{"label":{"description":"Label for this dataset","type":"string"},"data":{"description":"Data points - can be numbers or x/y points","$ref":"#/$defs/ChartDataValues"},"backgroundColor":{"description":"Optional background color for the dataset","type":"string"},"borderColor":{"description":"Optional border color for the dataset","type":"string"},"borderWidth":{"description":"Optional border width for the dataset","type":"number","format":"double"},"tension":{"description":"Optional tension for line curves (0 = straight lines, higher = more curved)","type":"number","format":"double"},"fill":{"description":"Optional fill setting for area under the line","type":"boolean"}},"required":["label","data"]},"ChartDataValues":{"description":"Chart data values - can be simple numbers or x/y points","anyOf":[{"description":"Simple numeric values (for line/bar charts with labels)","type":"array","items":{"type":"number","format":"double"}},{"description":"X/Y points (for scatter charts or line charts without labels)","type":"array","items":{"$ref":"#/$defs/ChartPoint"}}]},"ChartPoint":{"description":"Chart data point for scatter charts","type":"object","properties":{"x":{"description":"X coordinate","type":"number","format":"double"},"y":{"description":"Y coordinate","type":"number","format":"double"}},"required":["x","y"]}},"required":["data"],"type":"object","properties":{"data":{"description":"The data for the chart","$ref":"#/$defs/ChartData"}}}}},{"type":"function","function":{"name":"create_skill","description":"Create a new reusable skill and save it to the user's skills directory. The skill becomes usable immediately via load_skill, or by typing $name in the chat input.\n\nBefore creating one, load the \"skill-creator\" skill for authoring guidelines.","parameters":{"type":"object","required":["name","description","content"],"properties":{"name":{"type":"string","description":"Skill name: lowercase letters, digits, and hyphens only (e.g. \"release-checklist\")."},"description":{"type":"string","description":"When to use the skill. The model picks skills by this text alone, so state the trigger conditions, not the mechanics."},"content":{"type":"string","description":"Markdown instructions to follow when the skill is loaded. Use $ARGUMENTS where runtime input should be substituted."},"global":{"type":"boolean","description":"true (default) saves to ~/.agnes/skills for all projects; false saves to <working-dir>/.agnes/skills for this project only."},"argument_hint":{"type":"string","description":"Optional usage hint shown next to the skill in the $ picker, e.g. \"[file] [--strict]\"."}}}}},{"type":"function","function":{"name":"edit","description":"Edit a file by finding and replacing text. The before text must match exactly and uniquely. Use empty after text to delete. In Full access (auto) mode, destinations outside the current workspace are denied without a confirmation prompt, regardless of user_specified_output. In approval modes, for an external destination explicitly requested by the user, set user_specified_output=true and wait for this call's confirmation; otherwise the edit is denied.","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"FileEditParams","type":"object","properties":{"path":{"type":"string"},"before":{"type":"string"},"after":{"type":"string"},"user_specified_output":{"description":"Set true only when the user explicitly requested this workspace-external destination.","type":"boolean","default":false}},"required":["path","before","after"]}}},{"type":"function","function":{"name":"encyclopedia_search","description":"Search Wikipedia for canonical background on people, places, organizations, concepts, and historical topics; use web search for current information.","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"EncyclopediaSearchParams","type":"object","properties":{"query":{"description":"Topic or entity to search in Wikipedia.","type":"string"},"language":{"description":"Wikipedia language code, for example en, zh, ja, de. Defaults to en.","type":"string","default":null},"max_results":{"description":"Maximum results to return. Defaults to 5, capped at 10.","type":"integer","format":"uint","minimum":0,"default":null}},"required":["query"]}}},{"type":"function","function":{"name":"entity_facts","description":"Fetch a bounded structured fact list for a known Wikidata Q-id. Use entity_search first when the Q-id is unknown.","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"EntityFactsParams","type":"object","properties":{"id":{"description":"Wikidata item id, for example Q42. Use entity_search first if unsure.","type":"string"},"language":{"description":"Label language, for example en, zh, ja, de. Defaults to en.","type":"string","default":null}},"required":["id"]}}},{"type":"function","function":{"name":"entity_search","description":"Search Wikidata for an entity and stable Q-id. Use before entity_facts when the Q-id is unknown; never invent Q-ids.","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"EntitySearchParams","type":"object","properties":{"query":{"description":"Entity name to search in Wikidata.","type":"string"},"language":{"description":"Label language, for example en, zh, ja, de. Defaults to en.","type":"string","default":null},"max_results":{"description":"Maximum entities to return. Defaults to 8, capped at 20.","type":"integer","format":"uint","minimum":0,"default":null}},"required":["query"]}}},{"type":"function","function":{"name":"execute_typescript","description":"Execute TypeScript code with access to registered SDK functions.\n\nYour code runs in a TypeScript runtime with registered SDK functions already imported and available.\n\nCODE STRUCTURE:\nasync function run() {\n    // Your code here\n    // Call Namespace.functionName() with proper types\n    return result;\n}\n\nIMPORTANT RULES:\n- You MUST define a `run()` function\n- You MUST NOT call or export any functions from the root of the script, `run()` will be called automatically\n- ALWAYS batch multiple tool operations into ONE execute call\n- Functions MUST be called as 'Namespace.functionName'\n- Only registered SDK functions are available - no fetch(), fs, or other Node/Deno APIs\n- Variables don't persist between executions\n- Code runs in an isolated Deno sandbox\n\nTOKEN USAGE WARNING:\n- This tool could return LARGE responses if your code returns big objects\n- Filter/map/reduce data IN YOUR CODE before returning\n- Only return specific fields you need\n- Use console.log() for intermediate results\n\nRETURN TYPE NOTE:\n- Function results are already parsed JavaScript objects, NOT JSON strings\n- Do NOT call JSON.parse() on results\n- Access properties directly (e.g., result.data)","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ExecuteWithToolGraph","type":"object","properties":{"code":{"description":"Typescript code to execute.\n\nREQUIRED FORMAT:\nasync function ``run()`` {\n  // YOUR CODE GOES HERE\n  // ALWAYS RETURN THE RESULT e.g. return result;\n}\n\nIMPORTANT: Your code should ONLY contain the function definition.\nThe sandbox automatically calls run() and exports the result.","type":"string","default":""},"tool_graph":{"description":"DAG of tool calls showing execution flow. Each node represents a tool call.\nUse depends_on to show data flow (e.g., node 1 uses output from node 0).","type":"array","items":{"$ref":"#/$defs/ToolGraphNode"},"default":[]}},"$defs":{"ToolGraphNode":{"type":"object","properties":{"tool":{"description":"Tool name in format \"server/tool\" (e.g., \"developer/shell\")","type":"string"},"description":{"description":"Brief description of what this call does (e.g., \"list files in /src\")","type":"string"},"depends_on":{"description":"Indices of nodes this depends on (empty if no dependencies)","type":"array","items":{"type":"integer","format":"uint","minimum":0},"default":[]}},"required":["tool","description"]}},"required":[]}}},{"type":"function","function":{"name":"get_function_details","description":"Get detailed TypeScript definitions for specific functions.\n\nProvide function names in 'namespace.functionName' format (e.g., 'Notion.apiPostSearch').\nReturns full type signatures, parameter schemas, and return types.\n\nNote: Functions showing Promise<any> return type have no schema - the actual runtime\nvalue is a parsed JavaScript object (never a JSON string).","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"GetFunctionDetailsInput","type":"object","properties":{"functions":{"description":"List of functions to get details of.","type":"array","items":{"$ref":"#/$defs/FunctionId"}}},"required":["functions"],"$defs":{"FunctionId":{"description":"Function representation in the form should be in the form '<namespace>.<function name>'. e.g. If there is a function `getData` within the `DataApi` namespace the value provided in this field is DataApi.getData","type":"string"}}}}},{"type":"function","function":{"name":"image_search","description":"Search for and locally verify web images. Prefer explicitly requested or configured image tools. Batch multiple subjects. Do not publish candidates as user-facing artifacts unless the user asked to see or save the images. For reports, slides, HTML, or other documents set source_material=true.","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ImageSearchParams","type":"object","properties":{"query":{"description":"Concise image query. Optional when `queries` is provided.","type":"string","default":""},"queries":{"description":"Multiple image queries in one call (internally parallel). Prefer this when several subjects need images.","type":"array","items":{"type":"string"},"default":[]},"source_material":{"description":"True when the images are internal source material for another artifact. Forces publish_artifacts=false.","type":"boolean","default":false},"publish_artifacts":{"description":"Register verified images as user-facing artifacts. Defaults to true for direct image search requests. Set false, or set source_material=true, when gathering pictures for a report, slide, HTML page, or other document.","type":"boolean","default":true},"provider":{"description":"Optional provider: auto, bff, searchfree, searxng, or duckduckgo.","type":"string","default":null},"max_results":{"description":"Maximum images to return. Defaults to 8, capped at 20.","type":"integer","format":"uint","minimum":0,"default":null},"region":{"description":"DuckDuckGo/SearXNG region, for example us-en, wt-wt, uk-en, cn-zh.","type":"string","default":null},"safe_search":{"description":"Safe search setting: strict, moderate, or off.","type":"string","default":null},"size":{"description":"Optional image size hint: small, medium, large, wallpaper.","type":"string","default":null},"image_type":{"description":"Optional image type hint: photo, clipart, gif, transparent.","type":"string","default":null},"include_domains":{"description":"Restrict image source pages to these domains.","type":"array","items":{"type":"string"},"default":[]},"exclude_domains":{"description":"Exclude image source pages from these domains.","type":"array","items":{"type":"string"},"default":[]}},"required":[]}}},{"type":"function","function":{"name":"list_functions","description":"List all available SDK functions organized by namespace.\n\nReturns function signatures showing structure without full type details.","parameters":{"type":"object","properties":{},"required":[]}}},{"type":"function","function":{"name":"load","description":"List or load recipes, agents, and subrecipes, and inspect background tasks. With a task ID, wait by default; use peek to poll or cancel to stop it.","parameters":{"type":"object","properties":{"source":{"type":"string","description":"Name of the source to load. If omitted, lists all available sources."},"cancel":{"type":"boolean","default":false,"description":"For running background tasks: cancel and return output."},"peek":{"type":"boolean","default":false,"description":"For running background tasks: check progress without blocking. Returns turn count, idle time, and recent tool activity."}},"required":[]}}},{"type":"function","function":{"name":"load_skill","description":"Load a skill's full content into your context so you can follow its instructions.\n\nSkills are listed in your system instructions. When you need to use one, load it first to get the detailed instructions.\n\nExamples:\n- load_skill(name: \"gdrive\") → Loads the gdrive skill instructions\n- load_skill(name: \"my-skill\", args: \"the arguments for the skill\") → Loads a skill with arguments\n- load_skill(name: \"my-skill/template.md\") → Loads a supporting file","parameters":{"type":"object","required":["name"],"properties":{"name":{"type":"string","description":"Name of the skill to load. Use \"skill-name/path\" to load a supporting file."},"args":{"type":"string","description":"Optional arguments to provide when loading the skill."}}}}},{"type":"function","function":{"name":"read","description":"Fallback UTF-8 text-file reader when shell fails or is unavailable. You MUST try shell first. Do not use it for binary formats such as PDF, DOCX, or XLSX; use a matching extension tool instead. Accepts absolute paths, including files outside the current workspace when the user provides them. Optionally start at a 1-based line and limit how many lines are returned.","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"FileReadParams","type":"object","properties":{"path":{"description":"Absolute path to the file to read.","type":"string"},"line":{"description":"Line number to start reading from (1-based).","type":"integer","format":"uint32","minimum":1},"limit":{"description":"Maximum number of lines to read.","type":"integer","format":"uint32","minimum":0}},"required":["path"]}}},{"type":"function","function":{"name":"read_image","description":"Read an image from a local file path or http(s) URL and return it as image content for the model to inspect. Supports png, jpeg, gif, and webp.","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ImageReadParams","type":"object","properties":{"source":{"description":"Local file path or http(s) URL of the image to load.","type":"string"},"crop":{"description":"Optional crop rectangle in pixels. Coordinates are measured from the top-left corner.\nuse to zoom in and get more details.","default":null,"$ref":"#/$defs/CropParams"}},"required":["source"],"$defs":{"CropParams":{"type":"object","properties":{"x":{"description":"Left edge of the crop rectangle in pixels.","type":"integer","format":"uint32","minimum":0},"y":{"description":"Top edge of the crop rectangle in pixels.","type":"integer","format":"uint32","minimum":0},"width":{"description":"Width of the crop rectangle in pixels.","type":"integer","format":"uint32","minimum":0},"height":{"description":"Height of the crop rectangle in pixels.","type":"integer","format":"uint32","minimum":0}},"required":["x","y","width","height"]}}}}},{"type":"function","function":{"name":"read_webpage","description":"Read one or more public webpages and return extracted text, quote candidates, and blocked status. Batch primary URLs; blocked or empty pages are not evidence and should not be retried.","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ReadWebpageParams","type":"object","properties":{"url":{"description":"HTTP or HTTPS URL to read. Optional when `urls` is provided. Prefer `urls` for research.","type":"string","default":""},"urls":{"d