g: Longitude (required)\n- name: Location name\n- value: Numeric value for sizing/coloring\n- description: Description text\n- popup: Custom popup HTML\n- color: Custom marker color\n- label: Custom marker label\n- useDefaultIcon: Use default Leaflet icon\n\nExample:\n{\n  \"title\": \"Store Locations\",\n  \"markers\": [\n    {\"lat\": 37.7749, \"lng\": -122.4194, \"name\": \"SF Store\", \"value\": 150000},\n    {\"lat\": 40.7128, \"lng\": -74.0060, \"name\": \"NYC Store\", \"value\": 200000}\n  ]\n}","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"MapData":{"description":"Map data structure","type":"object","properties":{"markers":{"description":"Array of markers","type":"array","items":{"$ref":"#/$defs/MapMarker"}},"title":{"description":"Optional title for the map","type":"string"},"subtitle":{"description":"Optional subtitle","type":"string"},"center":{"description":"Optional center point","$ref":"#/$defs/MapCenter"},"zoom":{"description":"Optional initial zoom level","type":"number","format":"double"},"clustering":{"description":"Optional boolean to enable/disable clustering","type":"boolean"},"clusterRadius":{"description":"Optional cluster radius","type":"number","format":"double"},"autoFit":{"description":"Optional boolean to auto-fit map to markers","type":"boolean"}},"required":["markers"]},"MapMarker":{"description":"Map marker structure","type":"object","properties":{"lat":{"description":"Latitude (required)","type":"number","format":"double"},"lng":{"description":"Longitude (required)","type":"number","format":"double"},"name":{"description":"Location name","type":"string"},"value":{"description":"Numeric value for sizing/coloring","type":"number","format":"double"},"description":{"description":"Description text","type":"string"},"popup":{"description":"Custom popup HTML","type":"string"},"color":{"description":"Custom marker color","type":"string"},"label":{"description":"Custom marker label","type":"string"},"useDefau