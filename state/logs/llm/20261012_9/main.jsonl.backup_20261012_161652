4, rpm: 10, bias: 1.0, personaVariant: 'default',\n127:    apiKeyRef: 'AGNES_API_KEY_2', maxOutputTokens: 16384, rpm: 10, bias: 1.0, personaVariant: 'default',\n131:    apiKeyRef: 'OPENROUTER_API_KEY', maxOutputTokens: 4096, rpm: 20, rpd: 50, bias: 2.5, personaVariant: 'compact',\n198:function windowVerdict(count, startedAt, nowMs, limit, windowMs) {\n216:function dayVerdict(count, resetAt, nowMs, limit) {\n368:// personaVariant: default=正本人设；compact=小模型加强版（default_persona.compact.txt）\n442:function keyDigest(secret) {\n447:function loadKeystore() {\n493:function consumerPolicyFor(id) {\n538:function resolveIdentity(presented) {\n548:function decideLimits(policy, stats, nowMs) {\n575:function applyLimitCounts(stats, verdict, nowMs) {\n585:function persistConsumerStats() {\n617:function renderMetrics() {\n712:function logJSONL(entry) {\n764:function flushLogQueue() {\n813:function sendFakeStreaming(res, fullContent, modelId) {\n914:function isCircuitBroken(upstreamId) {\n927:function recordFailure(upstreamId, cls) {\n1021:// ==================== 刀12 配置热重载（R2） ====================// fs.watch 常态热加载 + 校验失败保持旧配置（原子换内存态，零重启断零连接）；坏配置拒载并落账 configReloadFailed。\n1024:const STATE_SUBTABLES = ['ewma', 'failures', 'circuitBreaker', 'lastCircuitBreakTime', 'tokenBuckets', 'lastRateLimitReset', 'backoffCount', 'pending', 'keyStates', 'dailyCounters', 'lastTrafficAt'];\n1025:function reloadConfig() {\n1039:    if (!nextIds.has(id)) for (const t of STATE_SUBTABLES) delete state[t][id]; // 下线腿：11 表全删\n1081:function scheduleReload(kind) {\n1089:try { fs.watch(CONFIG_PATH, () => scheduleReload('config')); } catch (e) { console.warn(`[警告] config watch 不可用: ${e.message}`); }\n1090:try { fs.watch(PERSONA_PATH, () => scheduleReload('persona')); } catch (e) { /* 同上 */ }\n1091:try { fs.watch(PERSONA_COMPACT_PATH, () => scheduleReload('persona')); } catch (e) { /* 同上 */ }\n1171:function classifyFailure(statusCode, bodyBuf, errorMsg) {\n1191:function orderCandidates(bodyBytes = 0, allowedLegIds = null) {\n1281:  if (upstream && upstream.personaVariant === 'compact' && PERSONA_COMPACT) return PERSONA_COMPACT;\n1299:      body.messages[sysIdx].content.includes(personaFingerprint(persona));","tool_call_id":"call_408808c2153f43a99d5e2995"},{"role":"assistant","tool_calls":[{"id":"call_f75fceec61514bef991901f8","type":"function","function":{"name":"read","arguments":"{\"path\":\"/Users/billtse/Desktop/泓家系统/恒林网关/gateway.js\",\"line\":90,\"limit\":80}"}}],"content":null},{"role":"tool","content":"const CONFIG_PATH = process.env.HENGLIN_CONFIG_PATH || path.join(__dirname, 'gateway.config.json');\nconst KEYSTORE_PATH = process.env.HENGLIN_KEYSTORE_PATH || path.join(HOME_DIR, '.dsh', 'henglin-consumers.json'); // 刀7 完整版：只存钥匙摘要，⛔存明文\nconst MAX_ATTEMPTS = 3;          // 一次请求最多改投几家上游（可被配置文件覆盖）\nconst UPSTREAM_TIMEOUT_MS = 25000;\n\n// 网关自己的钥匙（虚拟钥匙）\nconst GW_KEY_REF = 'HENGLIN_GW_KEY';\nconst GW_KEY_FILE = process.env.HENGLIN_GW_KEY_FILE || path.join(HOME_DIR, '.dsh', 'henglin-gateway.key');\n\n// 读默认人设（只许一个正本，⛔硬编码）\nlet DEFAULT_PERSONA = '';\ntry {\n  DEFAULT_PERSONA = fs.readFileSync(PERSONA_PATH, 'utf8').trim();\n} catch (e) {\n  console.warn(`[警告] 默认人设文件不存在: ${PERSONA_PATH}`);\n}\n\n// 小模型加强版人设（可选；没有就退回正本）\nlet PERSONA_COMPACT = '';\ntry {\n  PERSONA_COMPACT = fs.readFileSync(PERSONA_COMPACT_PATH, 'utf8').trim();\n} catch (e) { /* 无 compact 变体，用正本 */ }\n\n// 人设指纹：取前 12 字符，用于检测「客户端 system 里已经带过同款人格段」，防重复注入。\n// ⚠ 指纹按「将要注入的那份人设」现取（default 与 compact 各自指纹不同），不用全局单一指纹。\nfunction personaFingerprint(personaText) {\n  return (personaText || '').slice(0, 12);\n}\n\n// v0.5 配置外置：读 gateway.config.json（坏/缺不拒启，退回代码内默认）\nconst FALLBACK_UPSTREAMS = [\n  {\n    id: 'agnes-cn', name: 'Agnes 一号', baseURL: 'https://api.agnes-ai.cn/v1',\n    apiKeyRef: 'AGNES_API_KEY', maxOutputTokens: 16384, rpm: 10, bias: 1.0, personaVariant: 'default',\n  },\n  {\n    id: 'agnes-cn-2', name: 'Agnes 二号', baseURL: 'https://api.agnes-ai.cn/v1',\n    apiKeyRef: 'AGNES_API_KEY_2', maxOutputTokens: 16384, rpm: 10, bias: 1.0, personaVariant: 'default',\n  },\n  {\n    id: 'openrouter', name: 'OpenRouter 免费池', baseURL: 'https://openrouter.ai/api/v1',\n    apiKeyRef: 'OPENROUTER_API_KEY', maxOutputTokens: 4096, rpm: 20, rpd: 50, bias: 2.5, personaVariant: 'compact',\n  },\n];\n\n// ==================== 刀7 完整版：消费者名册与政策（2026-10-11）====================\n// 分工（⛔一个对象两份规格）：\n//   · gateway.config.json 的 consumers[] ＝【政策正本】（限额/配额/可调用模型/可用腿/开关）——热重载即生效；\n//   · ~/.dsh/henglin-consumers.json ＝【钥匙库】，只存 sha256 摘要（0600），⛔存明文、⛔存政策。\n//   两边靠 id 挂钩：config 有名无钥匙＝该消费者 401（/health 出声）；钥匙库有名无 config＝403 未登记（⛔发）。\n// 身份只认钥匙（Authorization: Bearer），X-Henglin-Client 头降级成「子标签」，⛔能冒充身份、⛔参与限额归属。\nconst CONSUMER_ID_RE = /^[a-z][a-z0-9_-]{1,39}$/;\nconst LEGACY_CONSUMER_ID = 'legacy'; // 主钥匙（~/.dsh/henglin-gateway.key）恒等于该 id，向后兼容 DSH\nconst DEFAULT_MAX_BODY_BYTES = 10_000_000; // 刀6 G7 入向 10MB 硬顶＝全局默认值，消费者可下调\n\nfunction badConsumer(doc, why) { // 统一出声口径：坏政策必须带 id 与原因，⛔静默降级\n  return new Error(`consumers[${doc && doc.id ? doc.id : '?'}]: ${why}`);\n}\n\nfunction normalizeConsumers(rawList, legIds) {\n  if (rawList === undefined || rawList === null) return [];\n  if (!Array.isArray(rawList)) throw badConsumer(null, '必须是数组');\n  const seen = new Set();\n  const out = [];\n  for (const c of rawList) {\n    if (!c || typeof c !== 'object') throw badConsumer(c, '条目必须是对象');\n    const id = String(c.id || '');\n    if (!CONSUMER_ID_RE.test(id)) throw badConsumer(c, `id 非法（要 ${CONSUMER_ID_RE.source}）`);\n    if (seen.has(id)) throw badConsumer(c, 'id 重复');\n    seen.add(id);\n    const posInt = (v, name) => {\n      if (v === undefined || v === null || v === false) return null; // 缺省/null＝不限（要「0」请写 null，0 视为笔误⇒出声拒载）\n      const n = Number(v);\n      if (!Number.isInteger(n) || n <= 0) throw badConsumer(c, `${name} 必须是正整数或 null（现在是 ${JSON.stringify(v)}）`);\n      return n;\n    };\n    const rpm = posInt(c.rpm, 'rpm');\n    const rpd = posInt(c.rpd, 'rpd');\n    const maxBodyBytes = posInt(c.maxBodyBytes, 'maxBodyBytes') || DEFAULT_MAX_BODY_BYTES;\n    if (maxBodyBytes > DEFAULT_MAX_BODY_BYTES) throw badConsumer(c, `maxBodyBytes 只能下调、⛔超过全局 ${DEFAULT_MAX_BODY_BYTES}`);\n","tool_call_id":"call_f75fceec61514bef991901f8"},{"role":"assistant","tool_calls":[{"id":"call_7f53c6e80d3b4c19a4cb4483","type":"function","function":{"name":"read","arguments":"{\"path\":\"/Users/billtse/Desktop/泓家系统/恒林网关/gateway.js\",\"line\":190,\"limit\":150}"}}],"content":null},{"role":"tool","content":"      note: typeof c.note === 'string' ? c.note.slice(0, 120) : '',\n    });\n  }\n  return out;\n}\n\n// 纯函数窗口判据（拆出来＝可被测试台直接推理与变异；「闸要能放行」的对照靠它）\n// 固定窗：跨过窗尾就整窗清零（返回新的 startedAt）；limit=null ⇒ 恒放行。\nfunction windowVerdict(count, startedAt, nowMs, limit, windowMs) {\n  if (!Number.isFinite(limit) || limit <= 0) return { allowed: true, unlimited: true, remaining: null, retryAfterMs: 0, count: count, resetAt: null };\n  const windowEnd = startedAt + windowMs;\n  if (nowMs >= windowEnd) return { allowed: true, fresh: true, remaining: limit - 1, retryAfterMs: 0, count: 1, resetAt: windowEnd }; // 新窗：本发计为第 1 颗\n  if (count >= limit) return { allowed: false, remaining: 0, retryAfterMs: Math.max(1, windowEnd - nowMs), count: count, resetAt: windowEnd };\n  return { allowed: true, remaining: limit - (count + 1), retryAfterMs: 0, count: count + 1, resetAt: windowEnd };\n}\n\nconst RATE_WINDOW_MS = 60000; // rpm＝每分钟固定窗（非令牌桶：给消费者的 429 要说得出「几点能回来」）\n\nfunction nextUtcMidnight(nowMs) {\n  const d = new Date(nowMs);\n  d.setUTCHours(0, 0, 0, 0);\n  if (d.getTime() <= nowMs) d.setUTCDate(d.getUTCDate() + 1);\n  return d.getTime();\n}\n\n// 日配额：resetAt 由账上带（跨进程重启也认），过期即整日清零\nfunction dayVerdict(count, resetAt, nowMs, limit) {\n  if (!Number.isFinite(limit) || limit <= 0) return { allowed: true, unlimited: true, remaining: null, retryAfterMs: 0, count: count, resetAt: null };\n  if (!Number.isFinite(resetAt) || nowMs >= resetAt) {\n    const nr = nextUtcMidnight(nowMs);\n    return { allowed: true, fresh: true, remaining: limit - 1, retryAfterMs: 0, count: 1, resetAt: nr };\n  }\n  if (count >= limit) return { allowed: false, remaining: 0, retryAfterMs: Math.max(1, resetAt - nowMs), count: count, resetAt: resetAt };\n  return { allowed: true, remaining: limit - (count + 1), retryAfterMs: 0, count: count + 1, resetAt: resetAt };\n}\n\nfunction loadGatewayConfig(throwOnBad) {\n  try {\n    const doc = JSON.parse(fs.readFileSync(CONFIG_PATH, 'utf8'));\n    if (!Array.isArray(doc.upstreams) || doc.upstreams.length === 0) throw new Error('upstreams 空');\n    // 刀7 完整版：consumers 若存在必须是数组（缺省＝老行为：只有主钥匙、零限额）\n    if (doc.consumers !== undefined && doc.consumers !== null && !Array.isArray(doc.consumers)) throw new Error('consumers 必须是数组');\n    return {\n      maxAttempts: Number.isInteger(doc.maxAttempts) && doc.maxAttempts > 0 ? doc.maxAttempts : MAX_ATTEMPTS,\n      upstreamTimeoutMs: Number.isInteger(doc.upstreamTimeoutMs) && doc.upstreamTimeoutMs > 0 ? doc.upstreamTimeoutMs : UPSTREAM_TIMEOUT_MS,\n      upstreams: doc.upstreams,\n      // P2.2：影子模式开关（true=六因子只算写审计、生产仍走现三因子+P1.3/P1.7 penalty；false=按六因子实际路由）\n      shadowMode: doc.shadowMode !== false,\n      // P2.2：六因子权重初值（C 班给；缺省用此，影子 3~5 天数据再校准定稿）\n      routingWeights: doc.routingWeights || { lat: .35, hlth: .20, cost: .15, load: .15, size: .10, prio: .05 },\n      // P2.4：完整 failureDomain 共享熔断（默认关=只本腿熔断；开=同域任腿 3 败熔断→同域兄弟腿也进 60s 半熔断。\n      // 默认关因风险高（Agnes 一号单 key 挂≠整域挂，误开会把二号也熔断→两腿全灭只剩 openrouter 跨域腿），需实跑观察「同域确实同生共死」后手动开）\n      sharedCircuitBreaker: doc.sharedCircuitBreaker === true,\n      // 刀6 G4/G6：预检在册名单 + 模型别名（映射进配置）\n      knownModels: Array.isArray(doc.knownModels) ? doc.knownModels : ['agnes-3.0-flash', 'agnes-2.5-flash'],\n      modelAliases: (doc.modelAliases && typeof doc.modelAliases === 'object') ? doc.modelAliases : {},\n      // 刀7 完整版：消费者名册（政策正本）。⛔名册里出现明文钥匙——限额/配额/可调用模型/可用腿在这颗文件，摘要在钥匙库。\n      consumers: normalizeConsumers(doc.consumers, doc.upstreams.map(u => u.id)),\n      source: 'gateway.config.json',\n    };\n  } catch (e) {\n    if (throwOnBad) throw e; // 刀12：热重载严格模式——坏配置直接抛，绝不退 fallback 名册（保持旧配置在跑）\n    console.warn(`[警告] 配置文件不可用(${e.message})，退回代码内默认名册`);\n    return {\n      maxAttempts: MAX_ATTEMPTS,\n      upstreamTimeoutMs: UPSTREAM_TIMEOUT_MS,\n      upstreams: FALLBACK_UPSTREAMS,\n      shadowMode: true, // P2.2：fallback 也默认影子态（零风险）\n      routingWeights: { lat: .35, hlth: .20, cost: .15, load: .15, size: .10, prio: .05 },\n      sharedCircuitBreaker: false, // P2.4：fallback 默认关（共享熔断风险高，需实跑观察后手动开）\n      knownModels: ['agnes-3.0-flash', 'agnes-2.5-flash'],\n      modelAliases: {},\n      consumers: [], // 刀7 完整版：兜底态＝只认主钥匙、零限额（老行为），消费者政策必须由配置文件说话\n      source: 'builtin-fallback',\n    };\n  }\n}\n\nlet GW_CONFIG = loadGatewayConfig(); // 刀12：let——热重载原子替换\nlet MAX_ATTEMPTS_EFF = GW_CONFIG.maxAttempts;\nlet UPSTREAM_TIMEOUT_MS_EFF = GW_CONFIG.upstreamTimeoutMs;\nlet SHADOW_MODE_EFF = GW_CONFIG.shadowMode;                 // P2.2\nlet ROUTING_WEIGHTS_EFF = GW_CONFIG.routingWeights;          // P2.2\nlet SHARED_CB_EFF = GW_CONFIG.sharedCircuitBreaker;          // P2.4：完整 failureDomain 共享熔断（默认关，需实跑观察同域同生共死后手动开）\nlet KNOWN_MODELS_EFF = GW_CONFIG.knownModels;                // 刀6 G4：预检在册名单\nlet MODEL_ALIASES_EFF = GW_CONFIG.modelAliases;              // 刀6 G4：别名映射（agnes-2.5-flash→agnes-3.0-flash）\n\n// 刀7 完整版：台账目录也可注入 ⇒ 测试台跑的是正本那颗 gateway.js（⛔拷一份去测），\n// 而 logs/requests.jsonl、consumer-stats.json、keystates.json 全部落在临时目录，⛔污染生产账。\nconst LOG_DIR = process.env.HENGLIN_LOG_DIR || path.join(__dirname, 'logs'); // §12.3：硬编码家路径改 __dirname（launchd 实例 __dirname=正本目录，与原路径逐字符等价零迁移，搬家不错位）\nconst JSONL_PATH = path.join(LOG_DIR, 'requests.jsonl');\n\nif (!fs.existsSync(LOG_DIR)) {\n  fs.mkdirSync(LOG_DIR, { recursive: true });\n}\n\n// === 读取钥匙 ===\nfunction loadCredentials() {\n  try {\n    const raw = fs.readFileSync(CREDENTIALS_PATH, 'utf8');\n    const doc = yaml.load(raw);\n    return doc.refs || {};\n  } catch (e) {\n    console.error(`[${new Date().toISOString()}] 读取 credentials 失败: ${e.message}`);\n    return {};\n  }\n}\n\nlet creds = loadCredentials(); // 刀12：let——热重载时随 config 一起重读（keyRef 换绑/钥匙轮换）\n\n// === 网关钥匙的读写（正本：credentials.yaml 的 HENGLIN_GW_KEY ＋ 落盘 keyfile）===\n\nfunction writeGatewayKey(key) {\n  // ① 独立钥匙文件（600）——§12.3：tmp+rename 原子写（防双写竞态半截文件；tmp 同目录保 rename 不跨卷）\n  try {\n    const tmpKey = GW_KEY_FILE + '.tmp';\n    try { fs.unlinkSync(tmpKey); } catch (_) { /* 无残留 */ }\n    fs.writeFileSync(tmpKey, key + '\\n', { mode: 0o600 });\n    fs.renameSync(tmpKey, GW_KEY_FILE);\n  } catch (e) {\n    console.warn(`[警告] 写钥匙文件失败: ${e.message}`);\n  }\n  // ② 并入 credentials.yaml 的 refs（纯文本插入，保留其它字节不动）\n  try {\n    const raw = fs.readFileSync(CREDENTIALS_PATH, 'utf8');\n    if (!new RegExp('^\\\\s*' + GW_KEY_REF + '\\\\s*:', 'm').test(raw)) {\n      const lines = raw.split('\\n');\n      const out = [];\n      let done = false;\n      for (let i = 0; i < lines.length; i++) {\n        out.push(lines[i]);\n        if (!done && /^refs:\\s*$/.test(lines[i])) {\n          let indent = '  ';\n          for (let j = i + 1; j < lines.length; j++) {\n            const m = lines[j].match(/^(\\s+)\\S/);\n            if (m) { indent = m[1]; break; }\n          }\n          out.push(`${indent}${GW_KEY_REF}: ${key}`);\n          done = true;\n        }\n      }\n      if (!done) {\n        console.warn('[警告] credentials.yaml 里找不到 refs: 段，钥匙未并入');\n        return;\n      }\n      // §12.3：tmp+rename 原子写（同目录防跨卷 EXDEV）\n      const tmpCred = CREDENTIALS_PATH + '.tmp';\n      try { fs.unlinkSync(tmpCred); } catch (_) { /* 无残留 */ }\n      fs.writeFileSync(tmpCred, out.join('\\n'), { mode: 0o600 });\n      fs.renameSync(tmpCred, CREDENTIALS_PATH);\n","tool_call_id":"call_7f53c6e80d3b4c19a4cb4483"},{"role":"assistant","tool_calls":[{"id":"call_f117ff41aaa64c79aaae90df","type":"function","function":{"name":"read","arguments":"{\"path\":\"/Users/billtse/Desktop/泓家系统/恒林网关/gateway.js\",\"line\":430,\"limit\":180}"}}],"content":null},{"role":"tool","content":"    lastRefill: Date.now(),\n  };\n}\n\nfor (const u of ALL_UPSTREAMS) {\n  initUpstreamState(u);\n}\n\n// ==================== 刀7 完整版：钥匙库 · 身份 · 限额 · 指标累加器 ====================\n// 钥匙库＝~/.dsh/henglin-consumers.json（0600，只存 sha256 摘要）；政策正本＝config.consumers[]（靠 id 挂钩）。\n// 明文钥匙只在 --grant 那一刻上屏一次，⛔进 config／⛔进台账／⛔进日志／⛔进证据纸（掩码形才下纸）。\n\nfunction keyDigest(secret) {\n  return crypto.createHash('sha256').update(String(secret)).digest('hex');\n}\n// 钥匙上纸只走正本掩码器 maskSecret（见下方工具函数区）——⛔在这里再立第二颗掩码规格\n\nfunction loadKeystore() {\n  try {\n    const doc = JSON.parse(fs.readFileSync(KEYSTORE_PATH, 'utf8'));\n    const map = {};\n    for (const e of (Array.isArray(doc.consumers) ? doc.consumers : [])) {\n      if (e && typeof e.id === 'string' && typeof e.keyDigest === 'string') map[e.keyDigest] = e.id;\n    }\n    return map;\n  } catch (e) {\n    return {}; // 无文件＝空库（首次 --grant 时建）；坏文件当空库并出声\n  }\n}\n\nfunction saveKeystore(map) {\n  const entries = Object.entries(map).map(([digest, id]) => ({ id, keyDigest: digest, createdAt: nowIso() }))\n    .sort((a, b) => a.id.localeCompare(b.id));\n  try {\n    const dir = path.dirname(KEYSTORE_PATH);\n    if (!fs.existsSync(dir)) fs.mkdirSync(dir, { recursive: true });\n    const tmp = KEYSTORE_PATH + '.tmp';\n    try { fs.unlinkSync(tmp); } catch (_) { /* 无残留 */ }\n    fs.writeFileSync(tmp, JSON.stringify({ version: 1, savedAt: nowIso(), note: '恒林网关消费者钥匙库：只存 sha256 摘要，⛔明文。限额/配额政策在 gateway.config.json 的 consumers[]。', consumers: entries }, null, 2), { mode: 0o600 });\n    fs.renameSync(tmp, KEYSTORE_PATH);\n    try { fs.chmodSync(KEYSTORE_PATH, 0o600); } catch (_) { /* 尽力 */ }\n    return true;\n  } catch (e) {\n    console.error(`[${nowIso()}] 钥匙库写入失败: ${e.message}`);\n    return false;\n  }\n}\n\nlet KEYSTORE = loadKeystore(); // digest → consumerId\n\n// 消费者运行时账（⛔与上游的 11 表混用——那是腿的账，这是人的账）\nconst consumerStats = {};       // id → { winStart, winCount, dayCount, dayResetAt }\nconst consumerPolicy = new Map(); // id → 归一化政策（config 正本派生，热重载重建）\nconst metrics = {\n  startedAt: Date.now(),\n  byConsumer: {},   // id → {total, ok, err, limited, quota, denied, unauthorized, tokensIn, tokensOut, dur:[], ttft:[]}\n  byUpstream: {},   // id → {ok, fail, pending 由 state.pending 现读}\n  inflight: 0,\n  unauthorized: 0,  // 刀7 完整版：⛔身份的请求（只计数，⛔记钥匙内容）\n  ledgerWriteErrors: 0, // 刀7 完整版：台账写盘失败批数（回队重试也算，连续失败要能在 /metrics 看到）\n};\nconst METRIC_HIST_MAX = 2000; // 分位数现算用的样本上限（环形截尾，⛔无限增长吃内存）\n\nfunction consumerPolicyFor(id) {\n  return consumerPolicy.get(id) || null;\n}\n\nfunction rebuildConsumerPolicy() {\n  consumerPolicy.clear();\n  for (const c of (GW_CONFIG.consumers || [])) consumerPolicy.set(c.id, c);\n  // legacy＝主钥匙的身份：config 里没显式声明就给「不限」默认（⛔把 DSH 现有用法限死）\n  if (!consumerPolicy.has(LEGACY_CONSUMER_ID)) {\n    consumerPolicy.set(LEGACY_CONSUMER_ID, {\n      id: LEGACY_CONSUMER_ID, name: '主钥匙（legacy）', enabled: true,\n      rpm: null, rpd: null, maxBodyBytes: DEFAULT_MAX_BODY_BYTES, models: null, upstreams: null,\n      note: '未在 config 声明 ⇒ 不限额、全腿、全模型（向后兼容）',\n    });\n  }\n  // 名册外的钥匙（库里有、config 没有）＝幽灵：保留摘要但请求时判 403 unregistered（⛔静默放行）\n}\nrebuildConsumerPolicy();\n\nfunction consumerStatsFor(id) {\n  if (!consumerStats[id]) {\n    consumerStats[id] = { winStart: Date.now(), winCount: 0, dayCount: 0, dayResetAt: nextUtcMidnight(Date.now()) };\n  }\n  return consumerStats[id];\n}\n\nfunction metricConsumer(id) {\n  if (!metrics.byConsumer[id]) {\n    metrics.byConsumer[id] = { total: 0, ok: 0, err: 0, limited: 0, quota: 0, denied: 0, tokensIn: 0, tokensOut: 0, dur: [], ttft: [] };\n  }\n  return metrics.byConsumer[id];\n}\n\nfunction metricUpstream(id) {\n  if (!metrics.byUpstream[id]) metrics.byUpstream[id] = { ok: 0, fail: 0, limitedByUpstream: 0 };\n  return metrics.byUpstream[id];\n}\n\nfunction pushSample(arr, v) {\n  if (typeof v !== 'number' || !Number.isFinite(v)) return;\n  arr.push(Math.round(v));\n  if (arr.length > METRIC_HIST_MAX) arr.shift();\n}\n\n// 身份判定：只认 Bearer——主钥匙＝legacy，消费者钥匙＝摘要命中，其余＝null\nfunction resolveIdentity(presented) {\n  if (!presented) return null;\n  if (presented === GATEWAY_KEY) return LEGACY_CONSUMER_ID;\n  const hit = KEYSTORE[keyDigest(presented)];\n  return hit || null;\n}\n\n// 限额闸＝纯判决（⛔改 stats、⛔发请求、⛔写台账——那些归调用方）\n// 返回 { allow, status, reason, retryAfterMs, limit, remaining, used, resetAt, next:{winStart,winCount,dayCount,dayResetAt} }\n// next＝放行后该写回的账；applyLimitCounts 是唯一执行处（判决与执行分两半＝测试台能拿同一函数推演负控）\nfunction decideLimits(policy, stats, nowMs) {\n  const base = { allow: true, status: 0, reason: '', retryAfterMs: 0, remaining: null, limit: null, used: null, resetAt: null };\n  if (!policy.enabled) {\n    return { ...base, allow: false, status: 403, reason: 'consumer_disabled' };\n  }\n  const wv = windowVerdict(stats.winCount, stats.winStart, nowMs, policy.rpm, RATE_WINDOW_MS);\n  const dv = dayVerdict(stats.dayCount, stats.dayResetAt, nowMs, policy.rpd);\n  if (!wv.allowed) {\n    return { ...base, allow: false, status: 429, reason: 'rate_limited', retryAfterMs: wv.retryAfterMs,\n      limit: policy.rpm, remaining: 0, used: stats.winCount, resetAt: wv.resetAt };\n  }\n  if (!dv.allowed) {\n    return { ...base, allow: false, status: 429, reason: 'daily_quota_exceeded', retryAfterMs: dv.retryAfterMs,\n      limit: policy.rpd, remaining: 0, used: stats.dayCount, resetAt: dv.resetAt };\n  }\n  // 放行＝分钟窗与日窗各进一颗（窗尾/日尾自动滚动清零，⛔粘着旧窗不放）\n  const winStart = (wv.fresh || nowMs - stats.winStart >= RATE_WINDOW_MS) ? nowMs : stats.winStart;\n  const next = {\n    winStart,\n    winCount: wv.count,\n    dayCount: dv.count,\n    dayResetAt: Number.isFinite(dv.resetAt) ? dv.resetAt : nextUtcMidnight(nowMs),\n  };\n  return { ...base, remaining: wv.remaining, limit: policy.rpm, used: wv.count, resetAt: wv.resetAt, next };\n}\n\n// 唯一写账处：只由放行分支调用（被闸挡住的发⛔占额度）\nfunction applyLimitCounts(stats, verdict, nowMs) {\n  if (!verdict.next) return; // 不限额（rpm/rpd 都缺省）⇒ 无需记账\n  stats.winStart = verdict.next.winStart;\n  stats.winCount = verdict.next.winCount;\n  stats.dayCount = verdict.next.dayCount;\n  stats.dayResetAt = verdict.next.dayResetAt;\n}\n\n// 运行时账落盘（重启不丢当日配额——否则重启＝白送一次额度重置）\nconst CONSUMER_STATS_PATH = path.join(LOG_DIR, 'consumer-stats.json');\nfunction persistConsumerStats() {\n  try {\n    const tmp = CONSUMER_STATS_PATH + '.tmp';\n    fs.writeFileSync(tmp, JSON.stringify({ savedAt: nowIso(), stats: consumerStats }));\n    fs.renameSync(tmp, CONSUMER_STATS_PATH);\n  } catch (e) { /* 落盘失败不挡主流程 */ }\n}\n(function loadConsumerStats() {\n  try {\n    const d = JSON.parse(fs.readFileSync(CONSUMER_STATS_PATH, 'utf8'));\n    const now = Date.now();\n    for (const id of Object.keys(d.stats || {})) {\n      const s = d.stats[id] || {};\n      // 只恢复「还没过期的窗」与「当天的日计数」；跨日/跨窗的旧账直接放弃（新窗本来就该清零）\n      const winStart = Number(s.winStart) || now;\n      const inWin = now - winStart < RATE_WINDOW_MS;\n      const dayAlive = Number(s.dayResetAt) > now;\n      consumerStats[id] = {\n        winStart: inWin ? winStart : now,\n        winCount: inWin ? (Number(s.winCount) || 0) : 0,\n        dayCount: dayAlive ? (Number(s.dayCount) || 0) : 0,\n        dayResetAt: dayAlive ? Number(s.dayResetAt) : nextUtcMidnight(now),\n      };\n    }\n  } catch (e) { /* 无文件/坏文件＝全新账 */ }\n","tool_call_id":"call_f117ff41aaa64c79aaae90df"},{"role":"assistant","tool_calls":[{"id":"call_c99f84953c6a449f895aab4d","type":"function","function":{"name":"read","arguments":"{\"limit\":320,\"line\":600,\"path\":\"/Users/billtse/Desktop/泓家系统/恒林网关/gateway.js\"}"}}],"content":null},{"role":"tool","content":"      const inWin = now - winStart < RATE_WINDOW_MS;\n      const dayAlive = Number(s.dayResetAt) > now;\n      consumerStats[id] = {\n        winStart: inWin ? winStart : now,\n        winCount: inWin ? (Number(s.winCount) || 0) : 0,\n        dayCount: dayAlive ? (Number(s.dayCount) || 0) : 0,\n        dayResetAt: dayAlive ? Number(s.dayResetAt) : nextUtcMidnight(now),\n      };\n    }\n  } catch (e) { /* 无文件/坏文件＝全新账 */ }\n})();\nsetInterval(persistConsumerStats, 30000).unref();\n\n// ---- /metrics 渲染（Prometheus 文本；口径＝本进程启动以来累计，⛔谎称等于台账全账）----\nconst METRIC_BUCKETS_MS = [100, 250, 500, 1000, 2000, 4000, 8000, 16000, 32000, 64000];\n\n// 渲染器：每个指标族只印一次 HELP/TYPE（Prometheus 硬要求），样本按调用顺序贴上去\nfunction renderMetrics() {\n  const lines = [];\n  const declared = new Set();\n  const declare = (name, type, zh) => {\n    if (!declared.has(name)) {\n      declared.add(name);\n      lines.push(`# HELP ${name} ${zh}`);\n      lines.push(`# TYPE ${name} ${type}`);\n    }\n  };\n  const say = (name, labels, value, type, zh) => {\n    declare(name, type, zh);\n    lines.push(`${name}${labels ? `{${labels}}` : ''} ${value}`);\n  };\n  const now = Date.now();\n\n  say('henglin_up_uptime_seconds', null, ((now - metrics.startedAt) / 1000).toFixed(1), 'gauge',\n      '本进程启动至今秒数。口径：/metrics 全部数字＝启动以来累计，⛔等于台账全账（台账按天轮转、这里重启清零）');\n  say('henglin_up_info', `version=\"${GW_VERSION}\",config=\"${String(GW_CONFIG.source).replace(/\"/g, '')}\"`, 1, 'gauge', '网关实例标识');\n  say('henglin_up_inflight', null, metrics.inflight, 'gauge', '已过闸、正在上游里处理的请求数');\n  say('henglin_up_consumers', null, consumerPolicy.size, 'gauge', 'config 名册里的消费者数（含 legacy）');\n  say('henglin_up_keys_granted', null, Object.keys(KEYSTORE).length, 'gauge', '钥匙库里已发的消费者钥匙摘要数');\n  say('henglin_up_legs_enabled', null, upstreams.length, 'gauge', '启用中的上游腿数');\n  say('henglin_up_legs_total', null, ALL_UPSTREAMS.length, 'gauge', '在册上游腿数（含 enabled:false 摘下的）');\n  say('henglin_up_shadow_mode', null, SHADOW_MODE_EFF ? 1 : 0, 'gauge', '六因子路由影子态：1＝只写审计不切流量');\n  say('henglin_up_unauthorized_total', null, metrics.unauthorized, 'counter', '鉴权失败（⛔身份）的累计次数——只计数，⛔记录来路钥匙');\n  say('henglin_up_ledger_flush_errors_total', null, metrics.ledgerWriteErrors, 'counter', '台账落盘失败批数（失败＝这批账没了，必须能在指标上看到）');\n\n  for (const [id, c] of Object.entries(metrics.byConsumer)) {\n    const lbl = `consumer=\"${id}\"`;\n    for (const k of ['total', 'ok', 'err', 'limited', 'quota', 'denied']) {\n      say('henglin_consumer_requests_total', `${lbl},outcome=\"${k}\"`, c[k] || 0, 'counter',\n          '消费者请求颗数按结局分档。⚠口径（2026-10-12 多消费者测试台 C36 逐档现量，纠正旧文案「total=过闸总数」）：'\n          + 'total＝认出身份并收下请求体之后的**每一颗**（含限额闸挡下的那颗、含闸前拒的 413、含预检 400），'\n          + '＝ok＋err＋limited＋quota＋denied 五档之和；'\n          + 'ok=成功｜err=失败档（413 与预检 400 也进这一档）｜limited=分钟限额挡｜quota=日配额挡｜denied=停用/越权挡。'\n          + '⇒ ⛔拿 total 当「放行的颗数」，要放行数请用 outcome=\"ok\"。');\n    }\n    say('henglin_consumer_tokens_total', `${lbl},kind=\"prompt\"`, c.tokensIn, 'counter', 'usage 抄账的 prompt token 合计（上游没回 usage 的行不计＝⛔镀 0）');\n    say('henglin_consumer_tokens_total', `${lbl},kind=\"completion\"`, c.tokensOut, 'counter', 'usage 抄账的 completion token 合计');\n    histInto(declare, l => lines.push(l), 'henglin_consumer_request_duration_ms', lbl, c.dur, '该消费者请求端到端时延（毫秒，样本上限 2000 条环形截尾）');\n    histInto(declare, l => lines.push(l), 'henglin_consumer_ttft_ms', lbl, c.ttft, '该消费者首字节/首帧时延（毫秒，口径同台账 ttftMs）');\n    const pol = consumerPolicy.get(id);\n    const st = consumerStats[id];\n    if (pol && st && pol.rpm) say('henglin_consumer_quota_remaining', `${lbl},window=\"minute\"`, Math.max(0, pol.rpm - st.winCount), 'gauge', '本分钟还剩几颗（固定窗，窗尾整窗清零）');\n    if (pol && st && pol.rpd) say('henglin_consumer_quota_remaining', `${lbl},window=\"day\"`, Math.max(0, pol.rpd - st.dayCount), 'gauge', '本日（UTC 日）还剩几颗');\n    if (pol) {\n      say('henglin_consumer_limit', `${lbl},window=\"rpm\"`, pol.rpm === null ? 'NaN' : pol.rpm, 'gauge', 'config 正本里的分钟上限（NaN＝不限）');\n      say('henglin_consumer_limit', `${lbl},window=\"rpd\"`, pol.rpd === null ? 'NaN' : pol.rpd, 'gauge', 'config 正本里的日上限（NaN＝不限）');\n      say('henglin_consumer_enabled', lbl, pol.enabled ? 1 : 0, 'gauge', '消费者开关（0＝enabled:false，请求拿 403）');\n    }\n  }\n\n  for (const [id, u] of Object.entries(metrics.byUpstream)) {\n    const lbl = `upstream=\"${id}\"`;\n    say('henglin_upstream_attempts_total', `${lbl},result=\"ok\"`, u.ok, 'counter', '该腿被尝试的颗数：成功档（一发请求换线三次＝三条腿各记一颗，⛔与消费者账相加）');\n    say('henglin_upstream_attempts_total', `${lbl},result=\"fail\"`, u.fail, 'counter', '该腿被尝试的颗数：失败档');\n    say('henglin_upstream_ewma_ms', lbl, Math.round(state.ewma[id] || 0), 'gauge', '该腿 EWMA 时延（选线输入，只记成功）');\n    say('henglin_upstream_pending', lbl, state.pending[id] || 0, 'gauge', '该腿在途请求数（六因子 normLoad 输入）');\n    say('henglin_upstream_failures_consecutive', lbl, state.failures[id] || 0, 'gauge', '该腿连续失败数（熔断 3 颗判据）');\n    say('henglin_upstream_circuit_breaker', lbl, state.circuitBreaker[id] === true ? 1 : 0, 'gauge', '该腿是否在熔断窗内');\n    say('henglin_upstream_key_state', lbl, ({ active: 0, cooldown: 1, frozen: 2, suspended: 3 })[state.keyStates[id] || 'active'], 'gauge', '0=active 1=cooldown 2=frozen 3=suspended（2/3 需人工）');\n    const dc = state.dailyCounters[id];\n    if (dc && Number.isFinite(dc.limit)) {\n      say('henglin_upstream_daily_used', lbl, dc.used, 'gauge', '该腿当日已用（上游侧 rpd，⛔与消费者 rpd 混为一谈）');\n      say('henglin_upstream_daily_limit', lbl, dc.limit, 'gauge', '该腿当日上限');\n    }\n  }\n  return lines.join('\\n') + '\\n';\n}\n\n// 直方图一族：只给「族名」声明一次 TYPE=histogram，样本行 _bucket(含 +Inf)/_sum/_count 直接贴（⛔给样本行另发 HELP/TYPE＝非法文本格式）；\n// 分位数另立一族 TYPE=gauge（histogram 与 summary 的 _quantile 混在一族也是非法形）\n// declare/push 由 renderMetrics 传入＝「族只声明一次」这条规则只此一处正本\nfunction histInto(declare, push, name, labels, samples, zh) {\n  declare(name, 'histogram', zh);\n  const sorted = (samples || []).slice().sort((a, b) => a - b);\n  const base = labels ? `${labels},` : '';\n  for (const le of METRIC_BUCKETS_MS) {\n    push(`${name}_bucket{${base}le=\"${le}\"} ${sorted.filter(x => x <= le).length}`);\n  }\n  push(`${name}_bucket{${base}le=\"+Inf\"} ${sorted.length}`);\n  push(`${name}_sum${labels ? `{${labels}}` : ''} ${sorted.reduce((a, b) => a + b, 0)}`);\n  push(`${name}_count${labels ? `{${labels}}` : ''} ${sorted.length}`);\n  if (sorted.length) {\n    declare(name + '_quantile', 'gauge', zh + ' 的分位近似（样本有环形截尾，分位只覆盖最近 2000 颗；另立一族⛔与 histogram 混族）');\n    const p = q => sorted[Math.min(sorted.length - 1, Math.ceil(q * sorted.length) - 1)];\n    for (const q of ['0.5', '0.95', '0.99']) {\n      push(`${name}_quantile{${base}quantile=\"${q}\"} ${p(Number(q))}`);\n    }\n  }\n}\n\n// === 工具函数 ===\n\nfunction logJSONL(entry) {\n  // 子标签名一颗正本（2026-10-12 收口时抓到）：同一颗 `X-Henglin-Client` 头，闸门那批行写的是 `subTag`、\n  // 走上游那批行写的是 `client` ⇒ 新消费者按任一颗读都只读到半本账（读 `client` 看不见被限额挡的那批，反之亦然）。\n  // 治＝在这里补齐另一颗（值只有这一个来源，⛔在十个调用处各写一遍＝十份规格）；\n  // 两颗名都留在纸上是迁移期双写，与 `durationMs`/`ttftMs` 同例（契约 §6），消费方改读 `clientId`＋`subTag` 后 `client` 可摘。\n  if (entry && entry.clientId !== undefined) {\n    if (entry.client === undefined && entry.subTag !== undefined) entry.client = entry.subTag;\n    else if (entry.subTag === undefined && entry.client !== undefined) entry.subTag = entry.client;\n  }\n  // P1.2 异步台账（洞③：热路径不再每请求同步写盘，改 500ms 批量落账，事件循环不被磁盘 IO 卡）\n  logQueue.push(JSON.stringify(entry) + '\\n');\n}\n\n// P1.6：挑出限额/冻结相关响应头落账（脱敏——不存全量头、不存 auth/cookie，只在自然出现 429/403 时自动留证，不刷超额制造）\nconst RATE_HEADER_KEYS = ['retry-after', 'x-ratelimit-reset', 'x-ratelimit-limit', 'x-ratelimit-remaining', 'x-ratelimit-retry-after', 'x-agnes-code', 'x-agnes-retry-after'];\nfunction selectRateHeaders(headers) {\n  if (!headers) return null;\n  const pick = {};\n  for (const k of RATE_HEADER_KEYS) {\n    if (headers[k] !== undefined) pick[k] = headers[k];\n  }\n  return Object.keys(pick).length ? pick : null;\n}\n\nconst logQueue = [];                 // P1.2：台账写队列（内存，批量落盘）\nconst LOG_QUEUE_MAX = 5000;          // P1.2：队列上限（防磁盘长期写失败时 OOM）\n\n// 刀10：台账按天轮转（UTC 日界，与上游 rpd 配额口径一致）——requests.jsonl 恒为「今天」，跨天 rename 成 requests-YYYY-MM-DD.jsonl，保留 30 天\nlet currentLogDay = new Date().toISOString().slice(0, 10);\nfunction rotateLogIfNeeded() {\n  const today = new Date().toISOString().slice(0, 10);\n  if (today === currentLogDay) return;\n  const prevDay = currentLogDay;\n  currentLogDay = today;\n  try {\n    if (fs.existsSync(JSONL_PATH)) {\n      try { fs.unlinkSync(path.join(LOG_DIR, `requests-${prevDay}.jsonl`)); } catch (_) { /* 目标已存在则先清 */ }\n      fs.renameSync(JSONL_PATH, path.join(LOG_DIR, `requests-${prevDay}.jsonl`));\n    }\n    // 保留 30 天：清过期归档\n    const cutoff = Date.now() - 30 * 86400 * 1000;\n    for (const f of fs.readdirSync(LOG_DIR)) {\n      const m = f.match(/^requests-(\\d{4}-\\d{2}-\\d{2})\\.jsonl$/);\n      if (m && new Date(m[1] + 'T00:00:00Z').getTime() < cutoff) {\n        try { fs.unlinkSync(path.join(LOG_DIR, f)); } catch (_) { /* 删不掉下轮再试 */ }\n      }\n    }\n  } catch (e) {\n    console.error(`[${nowIso()}] 台账轮转失败（不挡落账）: ${e.message}`);\n  }\n}\n\nfunction flushLogQueue() {\n  rotateLogIfNeeded(); // 刀10：跨天先轮转再落账\n  if (!logQueue.length) return;\n  const batch = logQueue.splice(0);  // 先取出本批（splice 成功才写盘，失败回队不丢账）\n  try {\n    fs.appendFileSync(JSONL_PATH, batch.join(''));\n  } catch (e) {\n    logQueue.unshift(...batch);                    // 写盘失败：回队保序不丢，下个 500ms 重试\n    if (logQueue.length > LOG_QUEUE_MAX) logQueue.length = LOG_QUEUE_MAX; // 超上限截断，防 OOM\n    metrics.ledgerWriteErrors++; // 刀7 完整版：失败颗数上 /metrics（⛔只吼一声就忘，观测面要能看见账有没有丢）\n    console.error(`[${nowIso()}] 台账写盘失败，回队重试: ${e.message}`);\n  }\n}\nsetInterval(flushLogQueue, 500).unref(); // P1.2：500ms 批量落账；unref() 不阻塞进程优雅退出\n\nfunction maskSecret(s) {\n  if (!s) return '<无>';\n  if (s.length <= 8) return '<已掩码>';\n  return s.substring(0, 4) + '...' + s.substring(s.length - 4);\n}\n\nfunction nowIso() {\n  return new Date().toISOString();\n}\n\n// 去掉 hop-by-hop 头，避免 length 不符\nfunction relayHeaders(headers) {\n  const h = { ...headers };\n  delete h['content-length'];\n  delete h['transfer-encoding'];\n  delete h['connection'];\n  delete h['keep-alive'];\n  h['X-Accel-Buffering'] = 'no'; // P2.1 治抖：防 Nginx/CDN 缓冲 SSE 帧（客户端拿到逐帧顺滑流，不被代理攒着）\n  return h;\n}\n\n// === 假流式重塑 ===\n\nfunction chunkText(text, minChunk = 2, maxChunk = 8) {\n  const chunks = [];\n  let i = 0;\n  while (i < text.length) {\n    const size = Math.floor(Math.random() * (maxChunk - minChunk + 1)) + minChunk;\n    chunks.push(text.slice(i, i + size));\n    i += size;\n  }\n  return chunks;\n}\n\nfunction sendFakeStreaming(res, fullContent, modelId) {\n  res.writeHead(200, {\n    'Content-Type': 'text/event-stream',\n    'Cache-Control': 'no-cache',\n    'Connection': 'keep-alive',\n  });\n\n  const chunks = chunkText(fullContent);\n  const completionId = `fake-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;\n\n  const firstChunk = {\n    id: completionId,\n    object: 'chat.completion.chunk',\n    created: Math.floor(Date.now() / 1000),\n    model: modelId,\n    choices: [{ index: 0, delta: { role: 'assistant', content: '' }, finish_reason: null }],\n  };\n  res.write(`data: ${JSON.stringify(firstChunk)}\\n\\n`);\n\n  let chunkIndex = 0;\n  const sendNextChunk = () => {\n    if (chunkIndex >= chunks.length) {\n      const finalChunk = {\n        id: completionId,\n        object: 'chat.completion.chunk',\n        created: Math.floor(Date.now() / 1000),\n        model: modelId,\n        choices: [{ index: 0, delta: { content: '' }, finish_reason: 'stop' }],\n      };\n      res.write(`data: ${JSON.stringify(finalChunk)}\\n\\n`);\n      res.write('data: [DONE]\\n\\n');\n      res.end();\n      return;\n    }\n\n    const chunk = {\n      id: completionId,\n      object: 'chat.completion.chunk',\n      created: Math.floor(Date.now() / 1000),\n      model: modelId,\n      choices: [{ index: 0, delta: { content: chunks[chunkIndex] }, finish_reason: null }],\n    };\n    res.write(`data: ${JSON.stringify(chunk)}\\n\\n`);\n    chunkIndex++;\n\n    const delay = Math.floor(Math.random() * 150) + 50;\n    setTimeout(sendNextChunk, delay);\n  };\n\n  sendNextChunk();\n\n  const heartbeat = setInterval(() => {\n    if (!res.writableEnded) {\n      res.write(': keep-alive\\n\\n');\n    } else {\n      clearInterval(heartbeat);\n    }\n  }, 10000);\n\n  res.on('finish', () => {\n    clearInterval(heartbeat);\n  });\n}\n\n// === 令牌桶 ===\n\nfunction tryConsumeToken(upstreamId) {\n  const bucket = state.tokenBuckets[upstreamId];\n  const now = Date.now();\n\n  const elapsed = (now - bucket.lastRefill) / 1000;\n  bucket.tokens = Math.min(bucket.maxTokens, bucket.tokens + elapsed * bucket.refillRate);\n  bucket.lastRefill = now;\n\n  if (bucket.tokens >= 1) {\n    bucket.tokens -= 1;\n    // P2.3：rpd 日计数桶——请求真正发出时 used++（对齐 OpenRouter 50/天，防 50 配额烧完还瞎打 429）\n    const dc = state.dailyCounters[upstreamId];\n    if (dc) dc.used += 1;\n    return true;\n  }\n  return false;\n}\n\n// P2.3：日限预检——429 冷却/日配额打满且未到 resetAt 的腿，主动拒发（省配额，非被动等 429）\n// 返回 {ok, reason}：ok=true 可发；ok=false 时该腿本轮不投（让位其它腿），reason 落台账对账\nfunction checkDailyQuota(upstreamId) {\n  const dc = state.dailyCounters[upstreamId];\n  const now = Date.now();\n  if (!dc || dc.limit === Infinity) return { ok: true }; // 缺 rpd 腿（Agnes）跳过日限（P1.3 已 90s 兜底 429）\n  if (dc.resetAt && now >= dc.resetAt) { // 跨日自动重置\n    dc.used = 0;\n    const nm = new Date(); nm.setUTCHours(0, 0, 0, 0); if (nm.getTime() <= Date.now()) nm.setDate(nm.getDate() + 1);\n    dc.resetAt = nm.getTime();\n  }\n  if (dc.used >= dc.limit) return { ok: false, reason: `daily_quota_exhausted(${dc.used}/${dc.limit})` };\n  return { ok: true };\n}\n\n// === 熔断器 ===\n\nfunction isCircuitBroken(upstreamId) {\n  const cb = state.circuitBreaker[upstreamId];\n  if (!cb) return false;\n\n  const elapsed = Date.now() - state.lastCircuitBreakTime[upstreamId];\n  if (elapsed < 0) return true; // 刀5 单调钟保护：系统时钟回拨按仍在熔断窗处理，不放行半开\n","tool_call_id":"call_c99f84953c6a449f895aab4d"},{"role":"assistant","tool_calls":[{"id":"call_2b6aa30525654d64a1013949","type":"function","function":{"name":"read","arguments":"{\"limit\":190,\"line\":914,\"path\":\"/Users/billtse/Desktop/泓家系统/恒林网关/gateway.js\"}"}}],"content":null},{"role":"tool","content":"function isCircuitBroken(upstreamId) {\n  const cb = state.circuitBreaker[upstreamId];\n  if (!cb) return false;\n\n  const elapsed = Date.now() - state.lastCircuitBreakTime[upstreamId];\n  if (elapsed < 0) return true; // 刀5 单调钟保护：系统时钟回拨按仍在熔断窗处理，不放行半开\n  if (elapsed > 60000) {\n    state.circuitBreaker[upstreamId] = false; // 半开\n    return false;\n  }\n  return true;\n}\n\nfunction recordFailure(upstreamId, cls) {\n  state.failures[upstreamId] = (state.failures[upstreamId] || 0) + 1;\n\n  if (state.failures[upstreamId] >= 3) {\n    state.circuitBreaker[upstreamId] = true;\n    state.lastCircuitBreakTime[upstreamId] = Date.now();\n    console.warn(`[${nowIso()}] ${upstreamId} 熔断（连续 ${state.failures[upstreamId]} 败）`);\n\n    // P2.4：完整 failureDomain 共享熔断（开关 SHARED_CB_EFF，默认关）。\n    // 开=同域任腿 3 败熔断→同域兄弟腿也进 60s 半熔断（洞① 同源相关故障完整设计）；\n    // 关=只本腿熔断（P1.7 的同域降权已做软降权，这里不硬熔断，避免 Agnes 一号单 key 挂把二号也误伤）。\n    if (SHARED_CB_EFF) {\n      try {\n        const host = new URL(ALL_UPSTREAMS.find(x => x.id === upstreamId)?.baseURL).host;\n        const peers = state.failureDomains[host] || [];\n        for (const peer of peers) {\n          if (peer !== upstreamId) {\n            state.circuitBreaker[peer] = true;\n            state.lastCircuitBreakTime[peer] = Date.now();\n            console.warn(`[${nowIso()}] ${peer} 同域(${host})联动半熔断（sharedCircuitBreaker 开，${upstreamId} 3 败）`);\n          }\n        }\n      } catch (e) { /* 异常 baseURL 不联动，只本腿熔断 */ }\n    }\n  }\n\n  // P2.3：key 状态机迁移（401→suspended 人工换key、403→frozen 停投喊人、402/429→cooldown 等reset自恢复；needsHuman 上抛 /health）\n  if (cls) {\n    if (cls.kind === 'auth') {\n      state.keyStates[upstreamId] = (cls.status === 401) ? 'suspended' : 'frozen'; // 401 吊销 / 403 冻结\n    } else if (cls.kind === 'payment' || cls.kind === 'ratelimit') {\n      state.keyStates[upstreamId] = 'cooldown'; // 额度/限流：临时冷却，等 reset 自恢复\n    }\n    if (cls.needsHuman) {\n      console.warn(`[${nowIso()}] ${upstreamId} ${cls.kind} 需人工介入：${cls.needsHuman}`);\n    }\n    if (cls.kind === 'auth' || cls.kind === 'payment' || cls.kind === 'ratelimit') persistKeyStates(); // 刀5：keyState 迁移落盘\n  }\n\n  // P2.3：跨次日 0 点重置日计数桶（顺带副作用，对齐「日配额次日恢复」）\n  const dc = state.dailyCounters[upstreamId];\n  if (dc && dc.resetAt && Date.now() >= dc.resetAt) {\n    dc.used = 0;\n    const nm = new Date(); nm.setUTCHours(0, 0, 0, 0); if (nm.getTime() <= Date.now()) nm.setDate(nm.getDate() + 1); // P2.3：UTC 次日 0 点（对齐 OpenRouter rpd 按 UTC 重置）\n    dc.resetAt = nm.getTime();\n  }\n}\n\nfunction recordSuccess(upstreamId) {\n  state.failures[upstreamId] = 0;\n  state.backoffCount[upstreamId] = 0;       // P1.1：腿恢复后清 429 退避计数\n  state.lastRateLimitReset[upstreamId] = 0;  // P1.1：腿恢复后清退避截止\n  if (state.keyStates[upstreamId] === 'cooldown') state.keyStates[upstreamId] = 'active'; // P2.3：cooldown 成功 → active（frozen/suspended 需人工，不自动恢复）\n  persistKeyStates(); // 刀5：keyState 迁移落盘（重启恢复人工态）\n}\n\nfunction updateEWMA(upstreamId, latencyMs) {\n  const alpha = 0.3;\n  state.ewma[upstreamId] = alpha * latencyMs + (1 - alpha) * (state.ewma[upstreamId] || 1000);\n}\n\n// ==================== 刀5 健康子系统（G8/G9/F3 收口） ====================\n\nlet shuttingDown = false; // 停机闸（刀13 防重入 + 刀5 健康哨探测闸；声明提前消除定时器回调 TDZ 脆弱）\n\n// ① EWMA 时间衰减：30s 向基线 1000ms 收敛 10%——失败/偶发慢灌顶的腿不再「25s 永不翻身」（F3：Agnes 被顶 13.3s 翻不了身的根治）\nsetInterval(() => {\n  for (const u of upstreams) {\n    const e = state.ewma[u.id] || 1000;\n    state.ewma[u.id] = Math.round(1000 + (e - 1000) * 0.9);\n  }\n}, 30000).unref();\n\n// ② keyStates 落盘（重启补偿）：frozen/suspended 是人工态，重启全清零会让冻结 key 静默回 active 继续撞 403——落盘 + 启动恢复\nconst KEYSTATES_PATH = path.join(LOG_DIR, 'keystates.json');\nfunction persistKeyStates() {\n  try {\n    const tmp = KEYSTATES_PATH + '.tmp';\n    fs.writeFileSync(tmp, JSON.stringify({ savedAt: nowIso(), keyStates: state.keyStates, lastRateLimitReset: state.lastRateLimitReset }));\n    fs.renameSync(tmp, KEYSTATES_PATH);\n  } catch (_) { /* 落盘失败不挡主流程 */ }\n}\n(function loadKeyStates() {\n  try {\n    const d = JSON.parse(fs.readFileSync(KEYSTATES_PATH, 'utf8'));\n    for (const k of Object.keys(d.keyStates || {})) {\n      if (d.keyStates[k] === 'frozen' || d.keyStates[k] === 'suspended') state.keyStates[k] = d.keyStates[k]; // 只恢复人工态\n    }\n    for (const k of Object.keys(d.lastRateLimitReset || {})) {\n      if ((d.lastRateLimitReset[k] || 0) > Date.now()) state.lastRateLimitReset[k] = d.lastRateLimitReset[k]; // 只恢复未过期冷却\n    }\n  } catch (_) { /* 无文件/坏文件：全新状态 */ }\n})();\n\n// ==================== 刀12 配置热重载（R2） ====================// fs.watch 常态热加载 + 校验失败保持旧配置（原子换内存态，零重启断零连接）；坏配置拒载并落账 configReloadFailed。\n// 代码不热载（守可控形态）；creds 随 config 一起重读（keyRef 换绑/钥匙轮换场景）。\n// 11 张 state 子表同步：存活腿状态原样保留、新增腿走 initUpstreamState、下线腿 11 表全删 + failureDomains 全局重建。\nconst STATE_SUBTABLES = ['ewma', 'failures', 'circuitBreaker', 'lastCircuitBreakTime', 'tokenBuckets', 'lastRateLimitReset', 'backoffCount', 'pending', 'keyStates', 'dailyCounters', 'lastTrafficAt'];\nfunction reloadConfig() {\n  let cfg;\n  try {\n    cfg = loadGatewayConfig(true); // 严格模式：坏配置抛错，绝不退 fallback 名册\n  } catch (e) {\n    console.error(`[${nowIso()}] 热重载拒载（保持旧配置继续跑）: ${e.message}`);\n    logJSONL({ timestamp: nowIso(), event: 'configReloadFailed', error: e.message });\n    return false;\n  }\n  const prevIds = new Set(ALL_UPSTREAMS.map(u => u.id));\n  creds = loadCredentials(); // keyRef 换绑/钥匙轮换随重载生效\n  const nextAll = cfg.upstreams.map(u => ({ ...u, apiKey: u.apiKeyRef ? creds[u.apiKeyRef] : (u.apiKey || null), enabled: u.enabled !== false }));\n  const nextIds = new Set(nextAll.map(u => u.id));\n  for (const id of Object.keys(state.ewma)) {\n    if (!nextIds.has(id)) for (const t of STATE_SUBTABLES) delete state[t][id]; // 下线腿：11 表全删\n  }\n  for (const u of nextAll) {\n    if (!prevIds.has(u.id)) initUpstreamState(u); // 新增腿：同一初始化逻辑（11 表一个不漏）\n  }\n  // 刀12 必改（复核班第 9 条）：failureDomains 全局重建（下线腿清残留、同 id 重上线防重复 push）\n  state.failureDomains = {};\n  for (const u of nextAll) {\n    try {\n      const host = new URL(u.baseURL).host;\n      if (!state.failureDomains[host]) state.failureDomains[host] = [];\n      if (!state.failureDomains[host].includes(u.id)) state.failureDomains[host].push(u.id);\n    } catch (e) { /* 异常 baseURL 跳过 */ }\n  }\n  ALL_UPSTREAMS.length = 0; ALL_UPSTREAMS.push(...nextAll);   // const 数组原位替换，引用不破\n  upstreams.length = 0; upstreams.push(...nextAll.filter(u => u.enabled !== false));\n  GW_CONFIG = cfg;                                            // 派生量原子换\n  MAX_ATTEMPTS_EFF = cfg.maxAttempts;\n  UPSTREAM_TIMEOUT_MS_EFF = cfg.upstreamTimeoutMs;\n  SHADOW_MODE_EFF = cfg.shadowMode;\n  ROUTING_WEIGHTS_EFF = cfg.routingWeights;\n  SHARED_CB_EFF = cfg.sharedCircuitBreaker;\n  KNOWN_MODELS_EFF = cfg.knownModels;\n  MODEL_ALIASES_EFF = cfg.modelAliases;\n  rebuildConsumerPolicy(); // 刀7 完整版：消费者政策随 config 热重载（限额/配额/开关改了即生效，⛔重启）\n  KEYSTORE = loadKeystore();        // 钥匙库同理（--grant 之后热重载即可用，不必重启）\n  console.log(`[${nowIso()}] 配置热重载完成（在册 ${ALL_UPSTREAMS.length} 腿，启用 ${upstreams.length} 腿，消费者 ${consumerPolicy.size} 个，钥匙摘要 ${Object.keys(KEYSTORE).length} 把）`);\n  logJSONL({ timestamp: nowIso(), event: 'configReloaded', upstreams: ALL_UPSTREAMS.map(u => u.id), consumers: [...consumerPolicy.keys()], keyCount: Object.keys(KEYSTORE).length });\n  return true;\n}\n\nfunction reloadPersonas() {\n  try {\n    const p = fs.readFileSync(PERSONA_PATH, 'utf8').trim();\n    const c = fs.readFileSync(PERSONA_COMPACT_PATH, 'utf8').trim();\n    if (p) DEFAULT_PERSONA = p;       // 校验失败（空）保持旧人设\n    PERSONA_COMPACT = c || '';\n    logJSONL({ timestamp: nowIso(), event: 'personaReloaded', defaultLen: p.length, compactLen: c.length });\n  } catch (e) { /* 读失败保持旧人设 */ }\n}\n\nlet reloadTimer = null;\nfunction scheduleReload(kind) {\n  if (reloadTimer) clearTimeout(reloadTimer); // 500ms 防抖（编辑器常一次保存多次触发）\n  reloadTimer = setTimeout(() => {\n    reloadTimer = null;\n    try { if (kind === 'persona') reloadPersonas(); else reloadConfig(); } catch (e) { console.error(`[${nowIso()}] 热重载异常: ${e.message}`); }\n  }, 500);\n  if (reloadTimer.unref) reloadTimer.unref();\n}\ntry { fs.watch(CONFIG_PATH, () => scheduleReload('config')); } catch (e) { console.warn(`[警告] config watch 不可用: ${e.message}`); }\ntry { fs.watch(PERSONA_PATH, () => scheduleReload('persona')); } catch (e) { /* 同上 */ }\ntry { fs.watch(PERSONA_COMPACT_PATH, () => scheduleReload('persona')); } catch (e) { /* 同上 */ }\n\n// ③ 健康哨探针（G9）：60s 只 ping「无流量 ≥2min 且带病」的腿——GET /models 零 token 成本；\n// 成功 → EWMA 重置 + 清失败计数 + cooldown 自愈（frozen/suspended 保持人工，不自动恢复）。rpd 打满的腿不探（省配额）\nsetInterval(() => {\n  if (typeof shuttingDown !== 'undefined' && shuttingDown) return;\n  const now = Date.now();\n  for (const u of upstreams) {\n    const idleMs = now - (state.lastTrafficAt[u.id] || now);\n    const broken = state.circuitBreaker[u.id] === true && now - (state.lastCircuitBreakTime[u.id] || 0) < 60000;\n    const sick = broken || (state.failures[u.id] || 0) > 0 || state.keyStates[u.id] === 'cooldown';\n    if (!sick || idleMs < 120000) continue;\n    const dc = state.dailyCounters[u.id];\n","tool_call_id":"call_2b6aa30525654d64a1013949"},{"role":"assistant","tool_calls":[{"id":"call_0bd2a39970bf4f3ea843b8fd","type":"function","function":{"name":"read","arguments":"{\"limit\":200,\"line\":1171,\"path\":\"/Users/billtse/Desktop/泓家系统/恒林网关/gateway.js\"}"}}],"content":null},{"role":"tool","content":"function classifyFailure(statusCode, bodyBuf, errorMsg) {\n  if (errorMsg) {\n    return { kind: errorMsg === 'timeout' ? 'timeout' : 'connection', retryable: true };\n  }\n  const text = bodyBuf ? bodyBuf.toString('utf8', 0, Math.min(bodyBuf.length, 4000)).toLowerCase() : '';\n  if (statusCode === 401 || statusCode === 403) return { kind: 'auth', retryable: false, status: statusCode, needsHuman: statusCode === 403 ? '403 key冻结，需人工查冻结/解冻' : '401 key吊销/无效，需人工换key' };\n  if (statusCode === 402) return { kind: 'payment', retryable: false, needsHuman: '额度耗尽/无钱，需人工充值或查日配额' }; // P0.5：没钱/冻结不可盲目重试（现 402 误落 other_4xx retryable:true）\n  if (statusCode === 408 || statusCode === 429) return { kind: 'ratelimit', retryable: true };\n  if (statusCode === 404) return { kind: 'notfound', retryable: true };\n  if (statusCode === 400) {\n    if (CONTEXT_WINDOW_SIGNS.some(s => text.includes(s))) return { kind: 'context_window', retryable: false };\n    return { kind: 'bad_request', retryable: false };\n  }\n  if (statusCode >= 500) return { kind: 'upstream_5xx', retryable: true };\n  if (statusCode >= 400) return { kind: 'other_4xx', retryable: true };\n  return { kind: 'unknown', retryable: true };\n}\n\n// === 选线：p2c + EWMA，返回按「优先尝试」排序的名册 ===\n\nfunction orderCandidates(bodyBytes = 0, allowedLegIds = null) {\n  const live = upstreams.filter(u => !isCircuitBroken(u.id));\n  // P2.3：key 状态机过滤——frozen(403)/suspended(401) 腿彻底停投（冷却/降权 P1.3 已做，这里只硬停「需人工介入」的腿）\n  const keyLive = live.filter(u => {\n    const ks = state.keyStates[u.id];\n    return ks !== 'frozen' && ks !== 'suspended'; // cooldown 仍可投（等 reset 自恢复），frozen/suspended 需人工 → 让位跨域腿/DSH 兜底\n  });\n  // 刀7 完整版：消费者可用腿白名单（consumers[].upstreams）——在熔断/key 过滤之后收窄，\n  // 名单里的腿全熔断了＝该消费者没腿可用（走全灭出口），⛔偷偷放它去别的腿\n  let base = keyLive.length ? keyLive : live; // 边界：全腿 frozen/suspended 时退化为 live（避免网关全灭 503，靠 DSH failover 兜底）\n  if (Array.isArray(allowedLegIds)) {\n    const allowed = base.filter(u => allowedLegIds.includes(u.id));\n    base = allowed; // 收窄后为空 ⇒ 调用方 candidates.length===0 出声（503 leg_not_allowed_for_consumer）\n  }\n  const routedBase = base;\n  const now = Date.now();\n\n  // P2.2 六因子分母（全池 max；除零保护：max===0 → 该因子归一值取 0/1，绝不进 NaN——审核班 #2 必补项）\n  const maxEwma    = routedBase.reduce((m, u) => Math.max(m, state.ewma[u.id] || 0), 0);\n  const maxCost    = routedBase.reduce((m, u) => Math.max(m, u.cost || 0), 0);          // config 全腿无 cost → maxCost=0 → normCost=1（不惩罚，安全）\n  const minCost    = routedBase.reduce((m, u) => Math.min(m, u.cost || 0), Infinity);   // 刀6 口径对齐：normCost=相对最低价（最便宜=1）\n  const costSpan   = maxCost - minCost;                                                  // 全免费池 span=0 → normCost 全 1（零回归）\n  const maxPending = routedBase.reduce((m, u) => Math.max(m, state.pending[u.id] || 0), 0); // 冷启动全 0 → maxPending=0 → normLoad=1（安全）\n  const maxBias    = routedBase.reduce((m, u) => Math.max(m, u.bias || 1), 0);\n\n  // P2.2 六因子分（每因子「越大越该选」；shadowMode=true 只写审计、生产仍走现三因子+penalty，故此处算错也不影响实际换腿）\n  const sixFactor = (u) => {\n    const normLat    = maxEwma    > 0 ? 1 - (state.ewma[u.id] || 0) / maxEwma       : 0;  // 最快=1\n    const normCost   = costSpan   > 0 ? 1 - ((u.cost || 0) - minCost) / costSpan      : 1;  // 刀6：对齐总纲公式「相对最低价 0~1」（原 1-cost/maxCost 与文档方向相反）\n    const normLoad   = maxPending > 0 ? 1 - (state.pending[u.id] || 0) / maxPending : 1;  // 全 0 → 都=1\n    const normHealth = 1 - Math.min(1, (state.failures[u.id] || 0) / 3);           // 健康=1（分母 3 固定，天然无除零）\n    const normPrio   = maxBias    > 0 ? 1 - (u.bias || 1) / maxBias               : 0;  // 高 bias=垫底（与现三因子一致）\n    // 刀6：体量路由真活（原恒 0 死因子）——粗估 token≈bytes/3，超过该腿 maxOutputTokens 视为「喂不进去」→ 归 0 垫底，小包≈1\n    const estTokens  = bodyBytes / 3;\n    const capTokens  = (u.maxOutputTokens || 8192);\n    const normSize   = estTokens > 0 ? Math.max(0, 1 - Math.min(1, estTokens / capTokens)) : 0;\n    const w = ROUTING_WEIGHTS_EFF;\n    const score = w.lat*normLat + w.hlth*normHealth + w.cost*normCost + w.load*normLoad + w.size*normSize + w.prio*normPrio;\n    return { score, factors: { lat:normLat, hlth:normHealth, cost:normCost, load:normLoad, size:normSize, prio:normPrio } };\n  };\n\n  // 排序键：保留 P1.3/P1.7 penalty 原样（审核班 #3 必补项——整替时不能丢 429 冷却/熔断降权）\n  const routed = routedBase.map(u => {\n    const jitter = 0.7 + 0.6 * Math.random(); // P2.2：存值供审计（当次抖动可复算）\n    let key = state.ewma[u.id] * (u.bias || 1) * jitter; // 现三因子（生产态排序键，含 p2c 抖动去粘滞）\n    let penalty = 1;\n    try {\n      const host = new URL(u.baseURL).host;\n      const selfInReset = (state.lastRateLimitReset[u.id] || 0) > now;\n      const domainInReset = (state.failureDomains[host] || []).some(\n        peer => (state.lastRateLimitReset[peer] || 0) > now);\n      if (selfInReset) penalty *= 2;\n      if (domainInReset) penalty *= 2;\n      // P1.7：同源熔断联动（纯读 state，不调 isCircuitBroken）\n      const domainInBreak = (state.failureDomains[host] || []).some(\n        peer => peer !== u.id && state.circuitBreaker[peer] === true\n               && (Date.now() - (state.lastCircuitBreakTime[peer] || 0)) <= 60000);\n      if (domainInBreak) penalty *= 2;\n    } catch (e) { /* 异常 baseURL/host → P1.3+P1.7 降权安全跳过 */ }\n    key *= penalty;\n    const sf = sixFactor(u);\n    return { u, key, jitter, penalty, sf };\n  });\n\n  // shadowMode=true（默认）→ 按现三因子+penalty 升序（生产行为零变，六因子只进审计）；\n  // shadowMode=false → 按六因子 score/penalty 降序（越大越优先；penalty>1 压低、jitter 小破平去粘滞）\n  routed.sort((a, b) => {\n    if (SHADOW_MODE_EFF) return a.key - b.key;\n    return (b.sf.score / b.penalty + b.jitter * 0.05) - (a.sf.score / a.penalty + a.jitter * 0.05);\n  });\n\n  // P2.2 审计字段（审核班 #5：当次 jitter/各因子/权重/影子态全落，可复算「这条为何选某腿」）\n  state.lastRoutingAudit = routed.map(x => ({\n    upstream: x.u.id,\n    key: Math.round(x.key),\n    jitter: +x.jitter.toFixed(3),\n    penalty: x.penalty,\n    sixFactor: +x.sf.score.toFixed(4),\n    factors: Object.fromEntries(Object.entries(x.sf.factors).map(([k, v]) => [k, +v.toFixed(3)])),\n    weights: ROUTING_WEIGHTS_EFF,\n    shadowMode: SHADOW_MODE_EFF,\n  }));\n\n  return routed.map(x => x.u); // 返回形状不变（上游对象数组），审计走 state.lastRoutingAudit 旁路，不破调用方\n}\n\n// === 请求体整形（人设 / 模型映射 / 夹 max_tokens）===\n\n// 按上游选人设变体（v0.5）：compact=小模型加强版；没有 compact 文件就退回正本\nfunction personaFor(upstream) {\n  if (upstream && upstream.personaVariant === 'compact' && PERSONA_COMPACT) return PERSONA_COMPACT;\n  return DEFAULT_PERSONA;\n}\n\nfunction buildRequestBody(upstream, parsedBody) {\n  const body = structuredClone(parsedBody);\n  const persona = personaFor(upstream);\n\n  // 人设「永远在场」（v0.5）：\n  //  ① 请求没有 system ⇒ 前插人格段；\n  //  ② 请求已有 system ⇒ 人格段作为第二条 system 并入（不动客户端原文），\n  //     人格段自身声明「语气人格以本段为准、任务指令以原有 system 为准」，两层不打架；\n  //  ③ 指纹防重复：已有 system 文本含人格段开头 12 字符 ⇒ 视为已注入，跳过。\n  //  治「客户端带了 system 人设就失效 ⇒ 换上游人格全靠各家模型底色」的旧漏洞。\n  if (Array.isArray(body.messages) && persona) {\n    const sysIdx = body.messages.findIndex(m => m.role === 'system');\n    const alreadyInjected = sysIdx !== -1 &&\n      typeof body.messages[sysIdx].content === 'string' &&\n      body.messages[sysIdx].content.includes(personaFingerprint(persona));\n    if (!alreadyInjected) {\n      const content = sysIdx === -1\n        ? persona\n        : `（衔接说明：语气与人格以下面这段为准；任务指令以原有 system 为准，两者不冲突。）\\n${persona}`;\n      const entry = { role: 'system', content };\n      if (sysIdx === -1) {\n        body.messages.unshift(entry);\n      } else {\n        body.messages.splice(sysIdx + 1, 0, entry);\n      }\n    }\n  }\n\n  // 模型别名归一（刀6 G4）：agnes-2.5-flash → agnes-3.0-flash（映射表进配置）\n  if (MODEL_ALIASES_EFF && typeof body.model === 'string' && MODEL_ALIASES_EFF[body.model]) {\n    body.model = MODEL_ALIASES_EFF[body.model];\n  }\n\n  // 该腿模型名映射（刀6 G6：原 openrouter 硬编码表进配置 upstream.modelMap，任何腿可配）\n  if (upstream.modelMap && typeof body.model === 'string') {\n    if (upstream.modelMap[body.model]) body.model = upstream.modelMap[body.model];\n  }\n\n  // 夹住 max_tokens：不超上游单次输出上限\n  // 刀8（R1）：流式 usage 抄账——OpenAI 协议 stream_options.include_usage（请求时主动带上，上游在 [DONE] 前推纯 usage 尾帧）。\n  // 按腿配置 supportsStreamOptions=true 才注入（Agnes 兼容性未探默认关，openrouter 设 true）；不支持的腿自动不注入=自动降级。\n  // 尾帧 choices:[] 原样转发（裸 pipe 不动帧），消费者零感知；官方警告「流中断拿不到尾帧」→ 该请求无 streamUsage 行即 usageMiss。\n  if (upstream.supportsStreamOptions === true && body.stream === true && typeof body.stream_options === 'undefined') {\n    body.stream_options = { include_usage: true };\n  }\n  if (upstream.maxOutputTokens) {\n    if (typeof body.max_tokens === 'number') {\n      body.max_tokens = Math.min(body.max_tokens, upstream.maxOutputTokens);\n    }\n    if (typeof body.max_completion_tokens === 'number') {\n      body.max_completion_tokens = Math.min(body.max_completion_tokens, upstream.maxOutputTokens);\n    }\n  }\n\n  return Buffer.from(JSON.stringify(body));\n}\n\n// === 单次上游尝试：收齐整包再 resolve，供上层判成败