cs／出口这些新增面的现网对照）：\n 1 非流式 200（真上游，答案带 usage）\n 2 流式 200＋响应头 content-type=text/event-stream＋帧里出 [DONE]\n 3 缺 model ⇒ 400（预检闸还在、⛔不透传白烧上游）\n 4 错钥匙 ⇒ 401\n 5 /health：status／degraded／腿数（旧字段零变）\n 6 /metrics 主钥匙 200＋版本一颗正本四处对齐（源码＝指标＝--check-config＝启动横幅现读）\n 7 消费者面现量：--list-consumers 退 0＋名册颗数；且 legacy 那颗⛔被算进消费者账\n 8 非白名单路径 ⇒ 403＋error.type＋台账落一行（对照＝白名单内的路⛔被这道门挡）\n\n安全纪律：\n · 钥匙只从 `node gateway.js --show-key` 现取到内存，⛔打印、⛔落文件（上纸一律打码）；\n · 本脚本⛔改生产配置、⛔grant/revoke 消费者钥匙（那是 CLI 台的活，跑在临时目录）；\n · 每一项的判据都吃真数据（⛔恒绿：401/400/403 那几项同时是「闸会拦」，200 那几项是「闸会放」）。\n\n用法：python3 smoke_check_20261012.py [--port 3020]\n退码：0＝八项全过｜1＝有没过项｜3＝前置不满足（服务没在跑／拿不到钥匙）\n\"\"\"\nimport json\nimport os\nimport re\nimport subprocess\nimport sys\nimport time\nimport urllib.error\nimport urllib.request\n\nHERE = os.path.dirname(os.path.abspath(__file__))\nGW_DIR = os.path.abspath(os.path.join(HERE, '..'))\nGW_JS = os.path.join(GW_DIR, 'gateway.js')\n# 服务的 stdout 落在哪儿＝plist 里 StandardOutPath 说的，⛔我手打一个路径当真（读不到＝横幅那颗没量到，判红）\nGW_SERVICE_LOG = os.environ.get('HENGLIN_SERVICE_LOG', '/tmp/henglin-gateway.log')\nMASK = '‹已打码›'\nRESULTS = []\nKEY = ''\nBASE = ''\n\n\ndef scrub(s):\n    return s.replace(KEY, MASK) if KEY else s\n\n\ndef say(name, ok, detail):\n    RESULTS.append({'case': name, 'pass': bool(ok), 'detail': scrub(detail)})\n    print(f\"[{'PASS' if ok else 'FAIL'}] {name}｜{scrub(detail)}\", flush=True)\n    return ok\n\n\ndef cli(args):\n    \"\"\"跑正本 CLI（不发流量），返回 (退码, stdout, stderr)\"\"\"\n    p = subprocess.run(['node', GW_JS] + args, capture_output=True, text=True, cwd=GW_DIR)\n    return p.returncode, p.stdout, p.stderr\n\n\ndef hit(path, key=None, payload=None, timeout=20):\n    \"\"\"打任意路径（leg8 用：非白名单那颗出口先前从没被任何尺量过，纸上「路径不在白名单」是句空话）\"\"\"\n    data = json.dumps(payload).encode() if payload is not None else None\n    req = urllib.request.Request(f'{BASE}{path}', data=data, method='POST' if data is not None else 'GET')\n    if key is not None:\n        req.add_header('Authorization', f'Bearer {key}')\n    if