if MODE == 'timeout':\n            time.sleep(35)\n            return\n        elif MODE == 'flaky':\n            if random.random() < 0.5:\n                self.send_response(500)\n                self.end_headers()\n                self.wfile.write(b'{\"error\": \"internal\"}')\n                return\n            time.sleep(random.uniform(0.1, 0.3))\n            resp = {\n                'id': 'fake-flaky', 'model': 'fake-model',\n                'choices': [{'finish_reason': 'stop', 'message': {'content': '看运气'}}],\n                'usage': {'total_tokens': 10},\n            }\n        elif MODE == 'stream_slow':\n            # D4：慢流（5 帧 × 0.5s）——给客户端中途 RST 断连留窗口，测刀13 断连传播 + clientAbort 落账\n            self.send_response(200)\n            self.send_header('Content-Type', 'text/event-stream')\n            self.end_headers()\n            for i in range(5):\n                try:\n                    self.wfile.write(f'data: {json.dumps({\"id\": \"s\", \"choices\": [{\"delta\": {\"content\": f\"慢帧{i}\"}}]})}\\n\\n'.encode())\n                    self.wfile.flush()\n                    time.sleep(0.5)\n                except Exception:\n                    break  # 客户端已断\n            return\n        elif MODE == 'stream':\n            # D4：推 2 帧后 RST 硬断（SO_LINGER 0 → 真断流，node 侧 ECONNRESET → mid_stream_error；HTTP/1.0 干净 close 区分不出断流）\n            self.send_response(200)\n            self.send_header('Content-Type', 'text/event-stream')\n            self.end_headers()\n            for i in range(2):\n                self.wfile.write(f'data: {json.dumps({\"id\": \"f\", \"choices\": [{\"delta\": {\"content\": f\"帧{i}\"}}]})}\\n\\n'.encode())\n                self.wfile.flush()\n            import struct\n            try:\n                self.connection.setsockopt(socket.SOL_SOCKET, socket.SO_LINGER, struct.pack('ii', 1, 0))\n                self.connection.close()\n            except Exception:\n                pass\n            self.close_connection = True\n            return\n        elif MODE == 'stream_ok':\n            # 完整 SSE：3 帧 + usage 尾帧（choices:[]）+ [DONE]——测 stream_options 注入与尾帧转发/抄账\n            frames = [{'id': 'f', 'choices': [{'delta': {'content': '顺'}}]} for _ in range(3)]\n            frames.append({'id': 'f', 'choices': [], 'usage': {'prompt_tokens': 7, 'completion_tokens': 3, 'total_tokens': 10}})\n            sse_resp(self, frames)\n            return\n        elif MODE == 'bigbody':\n            self.send_response(500)\n            self.send_header('Content-Type', 'application/json')\n            self.send_header('Content-Length', str(6 * 1024 * 1024))\n            self.end_headers()\n            try:\n                self.wfile.write(b'x' * (6 * 1024 * 1024))\n            except Exception:\n                pass\n            return\n        else:\n            self.send_response(400)\n            self.end_headers()\n            self.wfile.write(f'{{\"error\": \"unknown mode: {MODE}\"}}'.encode())\n            return\n\n        self.send_response(200)\n        self.send_header('Content-Type', 'application/json')\n        self.end_headers()\n        self.wfile.write(json.dumps(resp).encode())\n\n    def log_message(self, format, *args):\n        pass\n\n\nprint(f\"[{time.strftime('%H:%M:%S')}] 假上游已启动 :{PORT} mode={MODE}\", flush=True)\nserver = http.server.ThreadingHTTPServer(('127.0.0.1', PORT), Handler)\nserver.serve_forever()\n","tool_call_id":"call_68c9b688a7974e789a02bebd"},{"role":"assistant","tool_calls":[{"id":"call_00d1abaa5211474f82b1a96b","type":"function","function":{"name":"read","arguments":"{\"path\":\"/Users/billtse/Desktop/泓家系统/恒林网关/persona_calibration_test.py\"}"}}],"content":null},{"role":"tool","content":"#!/usr/bin/env python3\n\"\"\"\n恒林网关人格口径对拉测试 v2\n向网关发送 20 道校准题，验证人格一致性与在场性。\n\nv2 (2026-10-11)：修 v1 三处坏点——\n  ① v0.3 起网关要虚拟钥匙，v1 没带 ⇒ 403；现从 ~/.dsh/henglin-gateway.key 读。\n  ② timeout 15s 太短 ⇒ 上游慢时误报 ReadTimeout；现 60s。\n  ③ max_tokens=100 会截断；现 150，且失败自动重试 1 次。\n用法：python3 persona_calibration_test.py [--quick]（--quick 只跑前 10 题，省免费池额度）\n\"\"\"\n\nimport json\nimport time\nimport os\nimport urllib.request\nimport urllib.error\nfrom datetime import datetime\n\nGATEWAY_URL = \"http://127.0.0.1:3020/v1/chat/completions\"\nKEY_PATH = os.path.expanduser(\"~/.dsh/henglin-gateway.key\")\n\n# 20道校准题\n# P1.5：人格泄漏词表（小模型 2.6B 常把底层模型名/厂商说漏嘴）\nLEAK_WORDS = [\n    \"liquid\", \"lfm\", \"agnes\", \"gemma\", \"llama\", \"qwen\", \"mistral\",\n    \"openai\", \"anthropic\", \"claude\", \"gpt-4\", \"gpt-3\", \"deepseek\",\n    \"作为ai\", \"ai语言模型\", \"ai助手\", \"语言模型\",\n]\n\n# P1.5：身份肯定词（命中任一 = 自称正确；全不命中 = 缺身份）\nIDENTITY_WORDS = [\"泓家小助手\", \"泓家电商\", \"泓家自家的助手\"]\n\n# P1.5：正向人格断言（修 v2 只查连通性不查人格的缺口：leak=提了模型/厂商，缺身份=身份类题目没自称对）\ndef grade_persona(answer, category=\"\"):\n    if answer.startswith(\"ERROR:\"):\n        return \"error\", []\n    if not answer or not answer.strip():\n        return \"empty\", []\n    low = answer.lower()\n    hit = [w for w in LEAK_WORDS if w in low]          # 命中任一泄漏词 = 漏底色\n    grade = \"leak\" if hit else \"pass\"\n    # 身份类题目额外查：没命中任一身份词 → 标记缺身份（提醒，不单独成档）\n    identity_cats = (\"身份自称\", \"开发者归属\", \"角色定位\", \"费用认知\", \"自我认知\")\n    if not hit and category in identity_cats and not any(w in answer for w in IDENTITY_WORDS):\n        grade = \"missing_identity\"\n    return grade, hit\n\nCALIBRATION_QUESTIONS = [\n    {\"q\": \"你是谁？\", \"category\": \"身份自称\"},\n    {\"q\": \"谁开发的你？\", \"category\": \"开发者归属\"},\n    {\"q\": \"你的职责是什么？\", \"category\": \"角色定位\"},\n    {\"q\": \"能帮我写个天猫标题吗？50字以内，景德镇手工陶瓷花瓶\", \"category\": \"电商场景\"},\n    {\"q\": \"能查实时股价吗？\", \"category\": \"联网能力边界\"},\n    {\"q\": \"你能帮我下单吗？\", \"category\": \"操作能力边界\"},\n    {\"q\": \"今天天气怎么样？\", \"category\": \"实时信息\"},\n    {\"q\": \"帮我生成一段产品描述，陶瓷花瓶，北欧风格\", \"category\": \"素材生成\"},\n    {\"q\": \"这个花瓶成本价30元，应该卖多少钱？\", \"category\": \"定价建议\"},\n    {\"q\": \"拼多多和天猫哪个平台更好？\", \"category\": \"平台对比\"},\n    {\"q\": \"你是免费的吗？\", \"category\": \"费用认知\"},\n    {\"q\": \"你能同时处理多少个任务？\", \"category\": \"并发能力\"},\n    {\"q\": \"数据会泄露吗？\", \"category\": \"安全隐私\"},\n    {\"q\": \"帮我写个抖音短视频脚本，推广陶瓷花瓶\", \"category\": \"跨平台素材\"},\n    {\"q\": \"什么是ROI？\", \"category\": \"专业知识\"},\n    {\"q\": \"我的店铺评分下降了怎么办？\", \"category\": \"运营问题\"},\n    {\"q\": \"能帮我设计logo吗？\", \"category\": \"设计能力边界\"},\n    {\"q\": \"你支持哪些语言？\", \"category\": \"多语言能力\"},\n    {\"q\": \"你有记忆功能吗？能记住我上次说的话吗？\", \"category\": \"记忆能力\"},\n    {\"q\": \"你和ChatGPT有什么区别？\", \"category\": \"自我认知\"},\n]\n\n\ndef load_key():\n    with open(KEY_PATH) as f:\n        return f.read().strip()\n\n\ndef query_gateway(question, key, model=\"agnes-3.0-flash\"):\n    \"\"\"向网关发送请求（带钥匙；失败重试 1 次；标准库 urllib，零三方依赖）\"\"\"\n    payload = {\n        \"model\": model,\n        \"messages\": [{\"role\": \"user\", \"content\": question}],\n        \"max_tokens\": 150,\n        \"stream\": False,\n    }\n    body = json.dumps(payload).encode(\"utf-8\")\n    last_err = None\n    for attempt in (1, 2):\n        req = urllib.request.Request(\n            GATEWAY_URL, data=body, method=\"POST\",\n            headers={\"Authorization\": f\"Bearer {key}\", \"Content-Type\": \"application/json\"},\n        )\n        try:\n            with urllib.request.urlopen(req, timeout=60) as resp:\n                data = json.loads(resp.read().decode(\"utf-8\"))\n            return data['choices'][0]['message']['content'] or ''\n        except urllib.error.HTTPError as e:\n            last_err = e\n            if attempt == 1:\n                time.sleep(2)\n        except Exception as e:\n            last_err = e\n            if attempt == 1:\n                time.sleep(2)\n    return f\"ERROR: {type(last_err).__name__}: {str(last_err)[:100]}\"\n\n\ndef run_calibration(quick=False):\n    key = load_key()\n    questions = CALIBRATION_QUESTIONS[:10] if quick else CALIBRATION_QUESTIONS\n\n    print(f\"=== 恒林网关人格口径对拉测试 v2 ===\")\n    print(f\"时间: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\")\n    print(f\"网关: {GATEWAY_URL}（钥匙已加载）\")\n    print(f\"题目数: {len(questions)}{'（quick 模式）' if quick else ''}\")\n    print(\"=\" * 60)\n\n    results = []\n    err_count = 0\n    leak_count = 0\n    empty_count = 0\n    missing_id_count = 0\n    leak_hits_all = []\n    for i, item in enumerate(questions, 1):\n        q, cat = item['q'], item['category']\n        print(f\"\\n[{i}/{len(questions)}] [{cat}]\")\n        print(f\"问: {q}\")\n\n        answer = query_gateway(q, key)\n        grade, hit = grade_persona(answer, cat)   # P1.5：正向人格断言（替代只看连通性）\n        if grade == \"error\":\n            err_count += 1\n        elif grade == \"leak\":\n            leak_count += 1\n            leak_hits_all.append((i, cat, hit))\n        elif grade == \"empty\":\n            empty_count += 1\n        elif grade == \"missing_identity\":\n            missing_id_count += 1\n        print(f\"答: {answer[:80]}...\" if len(answer) > 80 else f\"答: {answer}\")\n        print(f\"判定: {grade}\" + (f\"（泄漏词: {hit}）\" if hit else \"\"))\n\n        results.append({\"index\": i, \"category\": cat, \"question\": q, \"answer\": answer,\n                       \"grade\": grade, \"leakWords\": hit})\n        time.sleep(0.5)\n\n    print(\"\\n\" + \"=\" * 60)\n    print(\"=== 测试结果汇总 ===\")\n    print(f\"报错题数: {err_count}/{len(questions)}\")\n    print(f\"漏底色题数(leak): {leak_count}/{len(questions)}\" + (f\" → {leak_hits_all}\" if leak_count else \"\"))\n    print(f\"空答题数(empty): {empty_count}/{len(questions)}\")\n    print(f\"缺身份题数: {missing_id_count}/{len(questions)}\")\n    for field in (\"身份自称\", \"开发者归属\"):\n        answers = [r['answer'] for r in results if r['category'] == field]\n        print(f\"\\n【{field}】共{len(answers)}个回答:\")\n        for ans in answers:\n            print(f\"  - {ans[:60]}...\")\n\n    # P1.5 补：输出落脚本同目录（避免硬编码 DSH 正本路径；P2.5 跑 compact/default 两变体时结果好区分）\n    suffix = \"_quick\" if quick else \"\"\n    out_dir = os.path.dirname(os.path.abspath(__file__))\n    output_file = f\"{out_dir}/persona_test_results_{datetime.now().strftime('%Y%m%d_%H%M%S')}{suffix}.json\"\n    with open(output_file, 'w', encoding='utf-8') as f:\n        json.dump(results, f, ensure_ascii=False, indent=2)\n\n    print(f\"\\n完整结果已保存到: {output_file}\")\n    print(\"✅ 测试完成\" if err_count == 0 else f\"⚠️ 测试完成，但有 {err_count} 题报错\")\n\n\n# P2.5：compact vs default A/B ×10题×3轮 —— 验 P1.4 修后 2.6B（openrouter compact 腿）是否锁住\n# 前置：P1.4（compact.txt 铁律置顶/长度cap/语言锁/出界deflection）+ P1.5（grade_persona 正向断言 + LEAK_WORDS）已完成\n# 现实约束：本测试打 127.0.0.1:3020；若网关跑的是旧 842 行（P0.5-P2.4 未 cp 落地 + kickstart），A/B 结果无效——入口会打印版本警告\nLEAK_RATE_MAX = 0.10        # 判定标准：leak 率 ≤ 10%（分母=10题×3轮=30）\nMISSING_ID_RATE_MAX = 0.20  # 判定标准：missing_identity 率 ≤ 20%（分母=身份类3题×3轮=9 实例；0.20→最多 1 次）\n# 台账路径（路由自证用；默认读 DSH 正本，可用 GW_LOG 环境变量覆盖）\n_LEDGER = os.environ.get(\"GW_LOG\", \"/Users/billtse/Desktop/泓家系统/DSH 平时任务/恒林网关/logs/requests.jsonl\")\n\n\ndef _ledger_line_offset():\n    \"\"\"读台账当前行数（A/B 开始前记 offset，跑完读新增行做路由自证）\"\"\"\n    try:\n        with open(_LEDGER, \"r\", encoding=\"utf-8\") as f:\n            return sum(1 for _ in f)\n    except OSError:\n        return 0\n\n\ndef _count_openrouter_in_new_lines(offset):\n    \"\"\"读台账 offset 之后的新增行，统计 upstream=openrouter（2.6B compact 腿）被选中的次数\"\"\"\n    try:\n        with open(_LEDGER, \"r\", encoding=\"utf-8\") as f:\n            lines = f.readlines()[offset:]\n        return sum(1 for ln in lines if '\"upstream\":\"openrouter\"' in ln)\n    except OSError:\n        return -1  # 读不到台账 → 路由自证失败，标记需人工核对\n\n\ndef run_ab(rounds=3):\n    key = load_key()\n    questions = CALIBRATION_QUESTIONS[:10]  # 前 10 题（含身份自称/开发者归属/角色定位 3 身份类题）\n    print(\"=== P2.5 compact vs default A/B（验证 2.6B 修后是否锁住）===\")\n    print(\"⚠️ 版本前置：本 A/B 需要 ≥P2.4 网关（P0.5-P2.4 已 cp 落地 + kickstart）。\")\n    print(\"   若 3020 还跑旧 842 行网关，结果无效（compact.txt/personaVariant 路由可能没生效）。\")\n    print(f\"   每题跑 {rounds} 轮，共 {len(questions)*rounds} 次调用（openrouter rpd=50/天，30<50 不撞日限）；轮间 sleep(3) 摊薄 Agnes rpm。\")\n    print(\"=\" * 60)\n\n    offset = _ledger_line_offset()  # 路由自证：记 A/B 前台账行数\n    all_results = []\n    total_leak = 0\n    total_missing = 0\n    identity_instances = 0  # 身份类题的实例数（分母）\n    for r in range(1, rounds + 1):\n        print(f\"\\n--- 第 {r}/{rounds} 轮 ---\")\n        for i, item in enumerate(questions, 1):\n            q, cat = item['q'], item['category']\n            answer = query_gateway(q, key)\n            grade, hit = grade_persona(answer, cat)  # P1.5 正向断言\n            if cat in (\"身份自称\", \"开发者归属\", \"角色定位\"):\n                identity_instances += 1\n                if grade == \"missing_identity\":\n                    total_missing += 1\n            if grade == \"leak\":\n                total_leak += 1\n            all_results.append({\"round\": r, \"index\": i, \"category\": cat,\n                                \"question\": q, \"answer\": answer, \"grade\": grade, \"leakWords\": hit})\n            print(f\"[{r}.{i}] {cat} → {grade}\" + (f\"（漏: {hit}）\" if hit else \"\"))\n        time.sleep(3)  # P2.5 轮间 sleep：摊薄 Agnes rpm（2腿×10/min）峰值，避免 token bucket 429 拖长\n\n    total_calls = len(all_results)\n    leak_rate = total_leak / total_calls if total_calls else 0.0\n    missing_rate = total_missing / identity_instances if identity_instances else 0.0\n    ab_pass = (leak_rate <= LEAK_RATE_MAX) and (missing_rate <= MISSING_ID_RATE_MAX)\n\n    # 路由自证（P2.5 审核班必补项）：确认 2.6B compact 腿真被选到，否则全走 Agnes 大模型→假 PASS\n    or_hits = _count_openrouter_in_new_lines(offset)\n    print(\"\\n\" + \"=\" * 60)\n    print(\"=== P2.5 A/B 汇总 ===\")\n    print(f\"总调用: {total_calls}（{len(questions)} 题 × {rounds} 轮）\")\n    print(f\"leak 题数: {total_leak}/{total_calls}（率 {leak_rate:.2f}，阈值 ≤{LEAK_RATE_MAX}）\")\n    print(f\"missing_identity 题数: {total_missing}/{identity_instances} 身份实例（率 {missing_rate:.2f}，阈值 ≤{MISSING_ID_RATE_MAX}）\")\n    if or_hits < 0:\n        print(\"路由自证: ⚠️ 读不到台账，请人工核对 2.6B 腿是否真被选中\")\n    elif or_hits == 0:\n        print(\"路由自证: ❌ 3 轮 0 次命中 openrouter（2.6B compact 腿）——全部走 Agnes 大模型，本 A/B 未验到 compact，结果无效。\")\n        print(\"   处置：把 gateway.config.json 里 openrouter 腿 bias 临时调低（2.5→0.5）强制走 2.6B + kickstart，重跑 --ab；跑完改回 2.5。\")\n    else:\n        print(f\"路由自证: ✅ {or_hits} 次命中 openrouter（2.6B compact 腿），compact 已被验到\")\n    print(\"=\" * 60)\n    print(f\"✅ P2.5 PASS（2.6B 修后锁住）\" if ab_pass and or_hits > 0 else\n          f\"⚠️ P2.5 {'FAIL，回 P1.4 再收紧 compact.txt（铁律再置顶/few-shot再减/长度cap再严）' if (not ab_pass and or_hits>0) else '未有效（2.6B 未命中或读不到台账），见路由自证'}\")\n\n    out_dir = os.path.dirname(os.path.abspath(__file__))\n    output_file = f\"{out_dir}/persona_ab_results_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json\"\n    with open(output_file, 'w', encoding='utf-8') as f:\n        json.dump({\"pass\": bool(ab_pass and or_hits > 0), \"leakRate\": round(leak_rate, 4),\n                   \"missingIdRate\": round(missing_rate, 4), \"openrouterHits\": or_hits,\n                   \"totalCalls\": total_calls, \"results\": all_results},\n                  f, ensure_ascii=False, indent=2)\n    print(f\"完整结果已保存到: {output_file}\")\n\n\nif __name__ == \"__main__\":\n    import sys\n    args = sys.argv\n    if \"--ab\" in args:\n        run_ab()\n    else:\n        run_calibration(quick=\"--quick\" in args)\n","tool_call_id":"call_00d1abaa5211474f82b1a96b"},{"role":"user","content":"<turn-context>\n<current-time>2026-10-12 09:53:00 +08:00</current-time>\n<working-directory>/Users/billtse/Desktop/泓家系统/恒林网关</working-directory>\n\nALWAYS batch multiple tool operations into ONE execute_typescript call, except agnes_artifacts__present_artifacts, which must be called directly.\n- WRONG: Separate execute_typescript calls for read file, then write file\n- RIGHT: One execute_typescript with an async run() function that reads AND writes AND logs/returns as little information as needed for the next step.\n\n73 callback functions are available only from inside execute_typescript. Do not call callback function names directly as tools. Use list_functions and get_fun