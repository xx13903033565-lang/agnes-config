ast.Return) and isinstance(n.value, ast.IfExp):\n            used.update(_int_literals(n.value))\n    doc = ast.get_docstring(tree) or ''\n    i = doc.find('退码')\n    # 只扫「退码」那一小节，行内并列的几档都要收到（⛔只认行首那颗＝漏档还会假装对平）\n    declared = {int(m.group(1)) for m in re.finditer(r'(?<![\\d.])(\\d+)=', doc[i:])} if i >= 0 else set()\n    return used, declared\n\n\ndef selftest():\n    \"\"\"自检腿一览见下方 name_ok 调用（真数据出建议／归一校验／夹幅／样本不足闸／全同因子／空台账／缺因子／坏行不吞／退码档位对拉）；\n    颗数与 PASS 数只由 results 现算打印，⛔在注释里手钉。\"\"\"\n    import tempfile\n    here = os.path.dirname(os.path.abspath(__file__))\n    base_cfg = json.load(open(os.path.join(here, 'gateway.config.json'), encoding='utf-8'))\n    results = []\n\n    def name_ok(n, ok, detail):\n        results.append((n, bool(ok)))\n        print(f\"  [{'PASS' if ok else 'FAIL'}] {n}：{detail}\")\n\n    def mk(cfg, rows):\n        d = tempfile.mkdtemp(prefix='hl_cal_')\n        cp = os.path.join(d, 'gateway.config.json')\n        json.dump(cfg, open(cp, 'w', encoding='utf-8'), ensure_ascii=False)\n        lp = os.path.join(d, 'logs')\n        os.makedirs(lp, exist_ok=True)\n        with open(os.path.join(lp, 'requests.jsonl'), 'w', encoding='utf-8') as f:\n            for r in rows:\n                f.write(json.dumps(r, ensure_ascii=False) + '\\n')\n        return cp, os.path.join(lp, 'requests.jsonl')\n\n    def audit_item(lid, lat=0.5, hlth=1.0, cost=1.0, load=1.0, size=1.0, prio=0.5, pen=1):\n        return {'upstream': lid, 'penalty': pen,\n                'factors': {'lat': lat, 'hlth': hlth, 'cost': cost, 'load': load, 'size': size, 'prio': prio}}\n\n    def row(up, dur, code=200, ttft=None, aud=None, attempted=None):\n        r = {'timestamp': '2026-10-11T00:00:00.000Z', 'upstream': up, 'statusCode': code,\n             'durationMs': dur, 'isStreamRequest': False, 'routingAudit': aud or []}\n        if ttft is not None:\n            r['ttftMs'] = ttft\n        if attempted is not None:\n            r['attempted'] = attempted\n        return r\n\n    cfg2 = dict(base_cfg)\n    cfg2['upstreams'] = [{'id': 'A', 'maxOutputTokens': 4096, 'bias': 1.0},\n                         {'id': 'B', 'maxOutputTokens': 4096, 'bias': 1.0}]\n    rows_many = []\n    for i in range(60):\n        # A 快且稳；B 慢且偶发失败；lat 因子与结果同向 ⇒ 建议应把 lat 抬起来\n        if i % 5 == 4:\n            rows_many.append(row('B', 1800 + i * 3, aud=[audit_item('A', lat=0.8), audit_item('B', lat=0.2)],\n                                 attempted=['A', ]))\n            rows_many.append(row('A', 300 + i, aud=[audit_item('A', lat=0.8), audit_item('B', lat=0.2)],\n                                 attempted=['B(500)', 'A']))","tool_call_id":"call_5acaf766c45943f28c8be479"},{"role":"user","content":"<turn-context>\n<current-time>2026-10-12 09:53:00 +08:00</current-time>\n<working-directory>/Users/billtse/Desktop/泓家系统/恒林网关</working-directory>\n\nALWAYS batch multiple tool operations into ONE execute_typescript call, except agnes_artifacts__present_artifacts, which must be called directly.\n- WRONG: Separate execute_typescript calls for read file, then write file\n- RIGHT: One execute_typescript with an async run() function that reads AND writes AND logs/returns as little information as needed for the next step.\n\n73 callback functions are available only from inside execute_typescript. Do not call callback function names directly as tools. Use list_functions and get_function_details to inspect signatures before writing one execute_typescript call.\n\n\nCurrent tasks and notes:\nOnce given a task, immediately update your todo with all explicit and implicit requirements. Complete every TODO update before starting the final user-facing response, and never call a TODO tool after the final response has started.\n\n\n# 每回合规矩（爱思办公 · 电商工作台）\n\n> 这段由 `AGNES_MOIM_MESSAGE_FILE` 每轮注入，每多一行每次请求就多背一行 ⇒ 只留「反复出错的」和「不能商量的」。\n> 引擎自己已经在 `<turn-context>` 里写了「批量进一次 execute_typescript」「先 list_functions/get_function_details 再写」，这里⛔重复那两句。\n\n## Code Mode（本机那批 TS 白跑换来的四条；颗数由 `agent_perf.py --check` ⑥ 段现印，⛔在这抄数）\n- ⛔ `import`／⛔ `fs`／⛔ `fetch`／⛔ 任何模块；只准用 `list_functions()` 列出的函数。\n- 一个 `run()` 里把整批做完，⛔拆成十几趟；变量不跨 `execute` 保留，要用的值当场重新取。\n- 返回值只要「字段＋条数」，⛔把整页结果原样 return。\n- 报 TS2339 之类＝字段名猜错了 ⇒ 回去读 `get_function_details` 的真实返回结构，⛔再猜一次。\n\n## 会话与上下文\n- 一场会话只干一件事，干完收口；⛔五件事塞一场。\n- 互相独立的活（逐款改标题、逐店盘库存）用 `delegate` 派子代理并行，⛔主会话里排队。\n- 会话变长变笨就 `/compact`，⛔硬撑到自动压缩。\n- @ 引用文件单份必须 <128KB（引擎硬闸，超了直接拒），长的先做摘要纸。\n\n## 电商口径（跟爸的规矩一致）\n- 读可以批量；**写必须逐颗**，写完立刻回读自证。\n- 平台上任何写动作（上架／改价／下架／发消息／投流／补货）**必须爸逐句点名**才动手；「都同意了」不算点名。\n- 纸上的每个数字都要脚本自己印出来，⛔手打、⛔引用过期读数。\n- 卡住⛔原地硬重试：先列清单（现量＋已试过＋缺口），缺口在爸侧就明说，我侧的缺口继续查。\n\n\n<turn-budget>13/25 used</turn-budget>\n</turn-context>"}],"tools":[{"type":"function","function":{"name":"agnes_artifacts__present_artifacts","description":"Register and present existing local files as user-facing session artifacts. Call this tool directly, never through execute_typescript, with exactly one primary file, and wait for its successful Presented artifact result before claiming delivery; Agnes verifies the accompanying artifact_created event system-side. Use this only after the user explicitly requested a standalone, reusable, or downloadable file, an output file or directory, or a specific output file format. Keep ordinary plans, proposals, reports, tables, and drafts in chat. DOCX, XLSX, XLSM, and PPTX files must have the required OOXML ZIP package structure, not text or XML saved with an Office extension. For qualifying updates, reuse the same primary file path or stable dedupe_key so the previous artifact card refreshes. Do not register ordinary codebase edits, guessed paths, input or reference files, or files that have not been written yet.","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"PresentArtifactsParams","type":"object","properties":{"title":{"description":"Human-readable artifact title.","type":"string"},"kind":{"description":"Artifact type.","type":"string","enum":["slide","document","spreadsheet","research_report","image","video","html","data","other"]},"dedupe_key":{"description":"Optional stable key. Use it when later exports should update the same artifact card.","type":"string","default":null},"user_specified_output":{"description":"Set true only when the user explicitly asked for this artifact to be saved at a\nworkspace-external file path or output directory instead of the default workspace artifact\ndirectory.","type":"boolean","default":false},"files":{"description":"Files that make up the artifact. Use exactly one primary file and optional preview/export/manifest files.","type":"array","items":{"$ref":"#/$defs/PresentArtifactFileParams"}}},"required":["title","kind","files"],"$defs":{"PresentArtifactFileParams":{"type":"object","properties":{"role":{"description":"File role inside the artifact bundle: primary, preview, export, manifest, thumbnail, or source.","default":null,"type":"string","enum":["primary","preview","export","manifest","thumbnail","source"]},"path":{"description":"Absolute or workspace-resolved local file path.","type":"string"},"mime_type":{"description":"Optional MIME type, for example text/markdown or application/pdf.","type":"string","default":null},"preview_type":{"description":"Preview renderer type: html, pdf, markdown, table, image, video, text, or external.","default":null,"type":"string","enum":["html","pdf","markdown","table","image","video","text","external"]}},"required":["path"]}}}}},{"type":"function","function":{"name":"analyze","description":"Analyze code structure in 3 modes: 1) Directory overview - file tree with LOC/function/class counts to max_depth. 2) File details - functions, classes, imports. 3) Symbol focus - call graphs across directory to max_depth (requires file or directory path, case-sensitive). Typical flow: directory → files → symbols. Functions called >3x show •N.","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"AnalyzeParams","type":"object","properties":{"path":{"description":"File or directory path to analyze","type":"string"},"focus":{"description":"Symbol name to focus on (triggers call graph mode)","type":"string","default":null},"max_depth":{"description":"Directory recursion depth limit (default 3, 0=unlimited). Also limits focus scan depth.","type":"integer","format":"uint32","minimum":0,"default":3},"follow_depth":{"description":"Call graph traversal depth (default 2, 0=definitions only)","type":"integer","format":"uint32","minimum":0,"default":2},"force":{"description":"Allow large outputs without size warning","type":"boolean","default":false}},"required":["path"]}}},{"type":"function","function":{"name":"autovisualiser__render_chord","description":"Show a chord diagram visualization for showing relationships and flows between entities.\n\nThe data must contain:\n- labels: Array of strings representing the entities\n- matrix: 2D array of numbers representing flows (matrix[i][j] = flow from i to j)\n\nExample:\n{\n  \"labels\": [\"North America\", \"Europe\", \"Asia\", \"Africa\"],\n  \"matrix\": [\n    [0, 15, 25, 8],\n    [18, 0, 20, 12],\n    [22, 18, 0, 15],\n    [5, 10, 18, 0]\n  ]\n}","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"ChordData":{"description":"Chord diagram data structure","type":"object","properties":{"labels":{"description":"Labels for each entity","type":"array","items":{"type":"string"}},"matrix":{"description":"2D matrix of flows (matrix[i][j] = flow from i to j)","type":"array","items":{"type":"array","items":{"type":"number","format":"double"}}}},"required":["labels","matrix"]}},"required":["data"],"type":"object","properties":{"data":{"description":"The data for the chord diagram","$ref":"#/$defs/ChordData"}}}}},{"type":"function","function":{"name":"autovisualiser__render_donut","description":"show pie or donut charts for categorical data visualization.\nSupports one or more charts in a grid layout.\nThe `data` field must always be an array; pass a single-element array for one chart.\n\nEach chart object must contain:\n- values: Array of numbers OR objects with 'label' and 'value'\n- type: Optional 'doughnut' (default) or 'pie'\n- title: Optional chart title\n- labels: Optional array of labels (required when values are plain numbers)\n\nExample single chart (labeled values):\n[\n  {\n    \"values\": [\n      {\"label\": \"Marketing\", \"value\": 25000},\n      {\"label\": \"Development\", \"value\": 35000}\n    ],\n    \"title\": \"Budget\"\n  }\n]\n\nExample single chart (parallel arrays):\n[\n  {\n    \"values\": [45000, 38000],\n    \"labels\": [\"Product A\", \"Product B\"],\n    \"type\": \"pie\"\n  }\n]\n\nExample multiple charts (array of chart objects):\n[\n  {\"values\": [60, 40], \"labels\": [\"Yes\", \"No\"], \"title\": \"Q1\"},\n  {\"values\": [75, 25], \"labels\": [\"Yes\", \"No\"], \"title\": \"Q2\"}\n]","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"SingleDonutChart":{"description":"Single donut/pie chart data","type":"object","properties":{"values":{"description":"Array of values — numbers (e.g. [10, 20]) or objects (e.g. [{\"label\": \"A\", \"value\": 10}])","type":"array","items":{"$ref":"#/$defs/DonutDataItem"}},"title":{"description":"Optional chart title","type":"string"},"type":{"description":"Optional chart type (doughnut or pie)","type":"string","enum":["doughnut","pie"]},"labels":{"description":"Optional labels array (used when values are just numbers)","type":"array","items":{"type":"string"}}},"required":["values"]},"DonutDataItem":{"description":"Data item for donut/pie charts - can be a number or labeled value","anyOf":[{"description":"Simple numeric value","type":"number","format":"double"},{"description":"Labeled value with explicit label","type":"object","properties":{"label":{"description":"Label for this data point","type":"string"},"value":{"description":"Numeric value","type":"number","format":"double"}},"required":["label","value"]}]}},"required":["data"],"type":"object","properties":{"data":{"description":"The chart data as an array of chart objects. Use a single-element array for one chart.","type":"array","items":{"$ref":"#/$defs/SingleDonutChart"}}}}}},{"type":"function","function":{"name":"autovisualiser__render_map","description":"show an interactive map visualization with location markers using Leaflet.\n\nThe data must contain:\n- markers: Array of objects with 'lat', 'lng', and optional properties\n- title: Optional title for the map (default: \"Interactive Map\")\n- subtitle: Optional subtitle (default: \"Geographic data visualization\")\n- center: Optional center point {lat, lng} (default: USA center)\n- zoom: Optional initial zoom level (default: 4)\n- clustering: Optional boolean to enable/disable clustering (default: true)\n- autoFit: Optional boolean to auto-fit map to markers (default: true)\n\nMarker properties:\n- lat: Latitude (required)\n- lng: Longitude (required)\n- name: Location name\n- value: Numeric value for sizing/coloring\n- description: Description text\n- popup: Custom popup HTML\n- color: Custom marker color\n- label: Custom marker label\n- useDefaultIcon: Use default Leaflet icon\n\nExample:\n{\n  \"title\": \"Store Locations\",\n  \"markers\": [\n    {\"lat\": 37.7749, \"lng\": -122.4194, \"name\": \"SF Store\", \"value\": 150000},\n    {\"lat\": 40.7128, \"lng\": -74.0060, \"name\": \"NYC Store\", \"value\": 200000}\n  ]\n}","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"MapData":{"description":"Map data structure","type":"object","properties":{"markers":{"description":"Array of markers","type":"array","items":{"$ref":"#/$defs/MapMarker"}},"title":{"description":"Optional title for the map","type":"string"},"subtitle":{"description":"Optional subtitle","type":"string"},"center":{"description":"Optional center point","$ref":"#/$defs/MapCenter"},"zoom":{"description":"Optional initial zoom level","type":"number","format":"double"},"clustering":{"description":"Opti