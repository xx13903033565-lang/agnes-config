lib.error.HTTPError as e:\n        return e.code, dict(e.headers or {}), e.read().decode('utf-8', 'replace')\n    except Exception as e:\n        # ⛔str(e)：异常文本可能把 Authorization 头整条回显出来（2026-10-09 那次的教训），只印类名\n        return -1, {}, f'客户端异常 type={type(e).__name__}'\n\n\ndef get(path, key=None, timeout=20):\n    req = urllib.request.Request(f'{BASE}{path}', method='GET')\n    if key is not None:\n        req.add_header('Authorization', f'Bearer {key}')\n    try:\n        with urllib.request.urlopen(req, timeout=timeout) as r:\n            return r.status, dict(r.headers), r.read().decode('utf-8', 'replace')\n    except urllib.error.HTTPError as e:\n        return e.code, dict(e.headers or {}), e.read().decode('utf-8', 'replace')\n    except Exception as e:\n        return -1, {}, f'客户端异常 type={type(e).__name__}'\n\n\ndef hdr(hd, name, default=''):\n    low = {str(k).lower(): v for k, v in (hd or {}).items()}\n    return low.get(str(name).lower(), default)\n\n\ndef main():\n    global KEY, BASE\n    argv = sys.argv[1:]\n    known = {'--port'}\n    unknown = [a for a in argv if a.startswith('-') and a not in known]\n    if unknown:\n        print(f'❌ 未知旗标：{unknown}｜本尺只认：{sorted(known)}', file=sys.stderr)\n        return 2\n    port = '3020'\n    if '--port' in argv:\n        port = argv[argv.index('--port') + 1]\n    BASE = f'http://127.0.0.1:{port}'\n    print(f'=== 恒林网关 生产冒烟八项 {time.strftime(\"%Y-%m-%d %H:%M:%S\")} · 靶={BASE} ===', flush=True)\n\n    st, _, text = get('/health')\n    if st != 200:\n        print(f'❌ 前置不满足：/health 没回 200（实得 {st}）。⛔把「服务没在跑」念成「测过了」。', file=sys.stderr)\n        return 3\n    rc, out, _err = cli(['--show-key'])\n    key_lines = [l.strip() for l in (out or '').splitlines() if l.strip()]\n    KEY = key_lines[0] if rc == 0 and key_lines else ''\n    if not KEY or len(KEY) < 16:\n        print(f'❌ 前置不满足：--show-key 退 {rc}、拿到 {len(KEY)} 颗字——现网主钥匙取不到（⛔用记忆里的旧钥匙凑）', file=sys.stderr)\n        return 3\n    print(f'主钥匙：现取到内存（长度 {len(KEY)}，上纸一律 {MASK}）', flush=True)\n\n    body = {'model': 'agnes-3.0-flash', 'messages': [{'role': 'user', 'content': '只回一个字：好'}],\n            'max_tokens': 8}\n\n    # 1) 非流式 200\n===BENCHMETRICS===\n    return GW_ENV['HENGLIN_CONFIG_PATH']\n\n\ndef parse_metrics(text):\n    \"\"\"Prometheus 文本 → (series{(name,(labels...)): value}, families[(name,type)], 非法行[])\n    治的形（2026-10-12 首跑 C15 假绿风险）：原先拿 m.group(2)（那颗指标名）去比 'TYPE' ⇒ 恒不等，\n    族表恒空＝「缺 histogram」必然报缺、而「重复声明/非法行」恒不报＝一把半边瞎的尺。\n    现在按空白切词取 (HELP|TYPE, 族名, 类型)，且 # 行不认识的一律进非法行（⛔静默跳过）。\"\"\"\n    series, fams, bad = {}, [], []\n    for line in text.splitlines():\n        s = line.strip()\n        if not s:\n            continue\n        if s.startswith('#'):\n            parts = s.split(None, 3)          # ['#', 'TYPE', 'name', 'gauge']／['#','HELP','name','文本…']\n            if len(parts) < 3 or parts[1] not in ('HELP', 'TYPE'):\n                bad.append(s)\n                continue\n            if parts[1] == 'TYPE':\n                fams.append((parts[2], parts[3] if len(parts) > 3 else ''))\n            continue\n        m = re.match(r'^([a-zA-Z_:][a-zA-Z0-9_:]*)(\\{[^}]*\\})?\\s+(\\S+)$', s)\n        if not m:\n            bad.append(s)\n            continue\n        name, lbl, val = m.group(1), m.group(2) or '', m.group(3)\n        labels = {}\n        if lbl:\n            for lm in re.finditer(r'([a-zA-Z_][a-zA-Z0-9_]*)=\"((?:[^\"\\\\]|\\\\.)*)\"', lbl):\n                labels[lm.group(1)] = lm.group(2)\n        try:\n            num = float(val)\n        except ValueError:\n            num = val\n        series[(name, tuple(sorted(labels.items())))] = num\n    return series, fams, bad\n\n\ndef metric(series, name, **labels):\n    return series.get((name, tuple(sorted(labels.items()))))\n\n\ndef secrets():\n    return [v for v in KEYS.values() if v] + [MASTER]\n\n\ndef secret_hits(path):\n    \"\"\"这颗件里有没有明文钥匙（消费者钥／主钥都算）。返回命中的类别名列表\"\"\"\n    try:\n        t = open(path, encoding='utf-8', errors='replace').read()\n    except Exception:\n        return []\n    return [('消费者钥' if k in t else None) for k in KEYS.values() if k and k in t] + \\\n           (['主钥匙'] if MASTER in t else [])\n\n\ndef metrics_families(fams, series):\n    \"\"\"把 C15 的格式判据抽成纯函数（尺的判据＝可被负控直接推理，⛔埋在断言里）\n    规则：①同一族⛔声明两次 ②histogram 用族名声明（⛔挂在 _bucket/_sum/_count/_quantile 样本名上）\n          ③该长的两条延迟直方图族必须在（⛔整段没长还判绿）④每条样本线都归在某颗已声明的族名下\n          ⑤族/线颗数下限＝防「解析器瞎了也判绿」：量到 0 族＝这把尺自己没靶\"\"\"","tool_call_id":"call_5116050a5af24f548f147798"},{"role":"user","content":"<turn-context>\n<current-time>2026-10-12 09:53:00 +08:00</current-time>\n<working-directory>/Users/billtse/Desktop/泓家系统/恒林网关</working-directory>\n\nALWAYS batch multiple tool operations into ONE execute_typescript call, except agnes_artifacts__present_artifacts, which must be called directly.\n- WRONG: Separate execute_typescript calls for read file, then write file\n- RIGHT: One execute_typescript with an async run() function that reads AND writes AND logs/returns as little information as needed for the next step.\n\n73 callback functions are available only from inside execute_typescript. Do not call callback function names directly as tools. Use list_functions and get_function_details to inspect signatures before writing one execute_typescript call.\n\n\nCurrent tasks and notes:\nOnce given a task, immediately update your todo with all explicit and implicit requirements. Complete every TODO update before starting the final user-facing response, and never call a TODO tool after the final response has started.\n\n\n# 每回合规矩（爱思办公 · 电商工作台）\n\n> 这段由 `AGNES_MOIM_MESSAGE_FILE` 每轮注入，每多一行每次请求就多背一行 ⇒ 只留「反复出错的」和「不能商量的」。\n> 引擎自己已经在 `<turn-context>` 里写了「批量进一次 execute_typescript」「先 list_functions/get_function_details 再写」，这里⛔重复那两句。\n\n## Code Mode（本机那批 TS 白跑换来的四条；颗数由 `agent_perf.py --check` ⑥ 段现印，⛔在这抄数）\n- ⛔ `import`／⛔ `fs`／⛔ `fetch`／⛔ 任何模块；只准用 `list_functions()` 列出的函数。\n- 一个 `run()` 里把整批做完，⛔拆成十几趟；变量不跨 `execute` 保留，要用的值当场重新取。\n- 返回值只要「字段＋条数」，⛔把整页结果原样 return。\n- 报 TS2339 之