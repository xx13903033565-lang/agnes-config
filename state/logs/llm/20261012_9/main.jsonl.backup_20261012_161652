:{"description":"Optional provider: auto, bff, searchfree, searxng, or duckduckgo.","type":"string","default":null},"max_results":{"description":"Maximum images to return. Defaults to 8, capped at 20.","type":"integer","format":"uint","minimum":0,"default":null},"region":{"description":"DuckDuckGo/SearXNG region, for example us-en, wt-wt, uk-en, cn-zh.","type":"string","default":null},"safe_search":{"description":"Safe search setting: strict, moderate, or off.","type":"string","default":null},"size":{"description":"Optional image size hint: small, medium, large, wallpaper.","type":"string","default":null},"image_type":{"description":"Optional image type hint: photo, clipart, gif, transparent.","type":"string","default":null},"include_domains":{"description":"Restrict image source pages to these domains.","type":"array","items":{"type":"string"},"default":[]},"exclude_domains":{"description":"Exclude image source pages from these domains.","type":"array","items":{"type":"string"},"default":[]}},"required":[]}}},{"type":"function","function":{"name":"list_functions","description":"List all available SDK functions organized by namespace.\n\nReturns function signatures showing structure without full type details.","parameters":{"type":"object","properties":{},"required":[]}}},{"type":"function","function":{"name":"load","description":"List or load recipes, agents, and subrecipes, and inspect background tasks. With a task ID, wait by default; use peek to poll or cancel to stop it.","parameters":{"type":"object","properties":{"source":{"type":"string","description":"Name of the source to load. If omitted, lists all available sources."},"cancel":{"type":"boolean","default":false,"description":"For running background tasks: cancel and return output."},"peek":{"type":"boolean","default":false,"description":"For running background tasks: check progress without blocking. Returns turn count, idle time, and recent tool activity."}},"required":[]}}},{"type":"function","function":