",\n  \"labels\": [\"Jan\", \"Feb\", \"Mar\"],\n  \"datasets\": [\n    {\"label\": \"Product A\", \"data\": [65, 59, 80]}\n  ]\n}","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"ChartData":{"description":"Chart data structure","type":"object","properties":{"type":{"description":"Chart type. Chart type enumeration. One of: line: Line chart; scatter: Scatter chart; bar: Bar chart","type":"string","enum":["line","scatter","bar"]},"datasets":{"description":"Datasets to display","type":"array","items":{"$ref":"#/$defs/ChartDataset"}},"labels":{"description":"Optional labels for x-axis (for line/bar charts)","type":"array","items":{"type":"string"}},"title":{"description":"Optional chart title","type":"string"},"subtitle":{"description":"Optional subtitle","type":"string"},"xAxisLabel":{"description":"Optional x-axis label","type":"string"},"yAxisLabel":{"description":"Optional y-axis label","type":"string"}},"required":["type","datasets"]},"ChartDataset":{"description":"Chart dataset structure","type":"object","properties":{"label":{"description":"Label for this dataset","type":"string"},"data":{"description":"Data points - can be numbers or x/y points","$ref":"#/$defs/ChartDataValues"},"backgroundColor":{"description":"Optional background color for the dataset","type":"string"},"borderColor":{"description":"Optional border color for the dataset","type":"string"},"borderWidth":{"description":"Optional border width for the dataset","type":"number","format":"double"},"tension":{"description":"Optional tension for line curves (0 = straight lines, higher = more curved)","type":"number","format":"double"},"fill":{"description":"Optional fill setting for area under the line","type":"boolean"}},"required":["label","data"]},"ChartDataValues":{"description":"Chart data values - can be simple numbers or x/y points","anyOf":[{"description":"Simple numeric values (for line/bar charts with labels)","type":"array","items":{"type":"number","format":"do