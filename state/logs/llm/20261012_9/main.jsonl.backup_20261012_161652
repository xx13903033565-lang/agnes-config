pstream.id] = (state.pending[upstream.id] || 0) + 1; // P2.2：真正发请求才 in-flight +1（normLoad）\n      state.lastTrafficAt[upstream.id] = Date.now(); // 刀5：健康哨 idle 判据（真实流量刷新）\n\n      const bodyBuffer = parsedBody ? buildRequestBody(upstream, parsedBody) : rawBody;\n\n      attemptUpstream(upstream, req.method, reqUrl, req.headers, bodyBuffer, isStreamRequest ? { streamTo: res } : null).then(result => {\n        state.pending[upstream.id] = Math.max(0, (state.pending[upstream.id] || 0) - 1); // P2.2：该腿 attempt 已 settle（成功/失败/committed 透传都过这里）→ in-flight -1，防 pending 泄漏\n        if (result.ok) {\n          recordSuccess(upstream.id);\n          updateEWMA(upstream.id, result.durationMs);\n          console.log(`[${nowIso()}] ${req.method} ${reqUrl.pathname} → ${upstream.name} ${result.statusCode} (${result.durationMs}ms)`);\n\n          // 风格观测：非透传路径拿得到全文 ⇒ 体检后随成功行落账\n          let styleFlags;\n          let usage;\n          if (!result.committed) {\n            try {\n              const rj = JSON.parse(result.body.toString());\n              styleFlags = styleFlagsFor(rj.choices?.[0]?.message?.content);\n              usage = (rj.usage && typeof rj.usage === 'object') ? rj.usage : undefined; // 刀8：非流式 usage 抄账（上游响应 usage 字段不再丢弃）\n            } catch (e) { /* 非 JSON 响应，跳过体检 */ }\n          }\n\n          const mu = metricUpstream(upstream.id);\n          mu.ok++;\n          mc.ok++;\n          pushSample(mc.dur, result.durationMs);\n          if (result.ttftMs !== undefined) pushSample(mc.ttft, result.ttftMs);\n          else if (result.committed) pushSample(mc.ttft, result.durationMs); // 透传行＝首帧时刻（与台账同口径）\n          if (usage) {\n            mc.tokensIn += (typeof usage.prompt_tokens === 'number' ? usage.prompt_tokens : 0);\n            mc.tokensOut += (typeof usage.completion_tokens === 'number' ? usage.completion_tokens : 0);\n          }\n\n          logJSONL({\n            timestamp: nowIso(),\n            upstream: upstream.id,\n            clientId,             