Content-Type': 'application/json' });\n1592:    logJSONL({ timestamp: nowIso(), subTag: clientTag, path: reqUrl.pathname, statusCode: 403, error: 'path_not_allowed' });\n1599:  // /metrics 只认主钥匙（消费者钥匙看不到全局账）\n1600:  if (isMetrics && presented !== GATEWAY_KEY) {\n1601:    res.writeHead(401, { 'Content-Type': 'application/json' });\n1602:    res.end(JSON.stringify({ error: { type: 'invalid_api_key', message: 'henglin-gateway: /metrics 需主钥匙（node gateway.js --show-key）。' } }));\n1611:  // 身份＝钥匙说了算：主钥匙→legacy；消费者钥匙→摘要命中；都不是→ 401\n1614:    res.writeHead(401, { 'Content-Type': 'application/json' });\n1621:    console.warn(`[${nowIso()}] 401 鉴权失败来自 ${req.headers.host || '?'} 路径 ${reqUrl.pathname}`);\n1623:    logJSONL({ timestamp: nowIso(), path: reqUrl.pathname, statusCode: 401, error: 'unauthorized', subTag: clientTag });\n1628:    res.writeHead(403, { 'Content-Type': 'application/json' });\n1630:    logJSONL({ timestamp: nowIso(), clientId, subTag: clientTag, path: reqUrl.pathname, statusCode: 403, error: 'consumer_unregistered' });\n1689:    metrics.inflight++; // 过闸才计在途（被限流的⛔占在途位）\n1690:    res.on('finish', () => { metrics.inflight = Math.max(0, metrics.inflight - 1); });\n1732:        res.writeHead(403, { 'Content-Type': 'application/json' });\n1740:        logJSONL({ timestamp: nowIso(), clientId, subTag: clientTag, path: reqUrl.pathname, model: parsedBody.model, statusCode: 403, error: 'model_not_allowed_for_consumer' });\n1746:    if (candidates.length === 0) {\n1752:      res.writeHead(503, { 'Content-Type': 'application/json' });\n1755:      // ⇒ 台账答不出「这个消费者今天吃了多少 503」（限额/鉴权 4xx 都有行，5xx 偏没有＝口径不齐）。\n1764:        statusCode: 503,\n1833:      state.pending[upstream.id] = (state.pending[upstream.id] || 0) + 1; // P2.2：真正发请求才 in-flight +1（normLoad）\n1839:        state.pending[upstream.id] = Math.max(0, (state.pending[upstream.id] || 0) - 1); // P2.2：该腿 attempt 已 settle（成功/失败/committed 透传都过这里）→ in-flight -1，防 pending 泄漏\n1911:        recordFailure(upstream.id, cls); // P2.3：传 cls，让 recordFailure 迁 key 状态机（401→suspended/403→frozen/402/429→cooldown）\n1960:          rateHeaders: selectRateHeaders(result.headers),      // P1.6：脱敏留证（429/403 自然出现时抓 Retry-After/X-RateLimit*/X-AGNES*，不存全量/auth）\n2013:  console.log(`  路径注入：HENGLIN_CONFIG_PATH / HENGLIN_CREDENTIALS_PATH / HENGLIN_GW_KEY_FILE / HENGLIN_KEYSTORE_PATH / HENGLIN_LOG_DIR / HENGLIN_PORT（默认值＝生产位置，测试台用临时目录）`);\n2028:  if (ghosts.length) console.log(`⚠ 幽灵钥匙（库里有摘要、名册里没政策，请求会拿 403）：${ghosts.join(', ')}`);\n2096:  console.log(`✅ 已收回 ${id} 的 ${before - after} 把钥匙（配置热重载后该钥匙拿 401）`);\n2102:  console.log(GATEWAY_KEY);","tool_call_id":"call_bd12f5329bae4b9398a93ccc"},{"role":"assistant","tool_calls":[{"id":"call_a22cd6c58ff84b72b775bc83","type":"function","function":{"name":"read","arguments":"{\"limit\":120,\"line\":1533,\"path\":\"/Users/billtse/Desktop/泓家系统/恒林网关/gateway.js\"}"}}],"content":null},{"role":"tool","content":"  if (reqUrl.pathname === '/health') {\n    res.writeHead(200, { 'Content-Type': 'application/json' });\n    // 刀15 全灭喊人（纯读不触发半开——P1.7 教训：isCircuitBroken 带翻转副作用，这里镜像时间窗判据）\n    const allDown = upstreams.length > 0 && upstreams.every(u =>\n      (state.circuitBreaker[u.id] === true && Date.now() - (state.lastCircuitBreakTime[u.id] || 0) < 60000) ||\n      state.keyStates[u.id] === 'frozen' || state.keyStates[u.id] === 'suspended');\n    res.end(JSON.stringify({\n      status: 'ok',\n      degraded: allDown, // 刀15：true=全部可用腿都在熔断窗/需人工，消费端可据此告警\n      timestamp: nowIso(),\n      authRequired: true,\n      upstreams: ALL_UPSTREAMS.map(u => ({\n        id: u.id,\n        name: u.name,\n        enabled: u.enabled !== false,\n        ewma: Math.round(state.ewma[u.id]),\n        circuitBreaker: state.circuitBreaker[u.id],\n        failures: state.failures[u.id],\n        keyState: state.keyStates[u.id] || 'active', // P2.3：key 状态机（active/cooldown/frozen/suspended），父排障一眼看到哪条 key 冻结/吊销\n      })),\n      // P2.3：待人工介入的腿（frozen/suspended），父看到就该换 key / 查冻结 / 充值\n      keyNeedsHuman: ALL_UPSTREAMS.filter(u => {\n        const ks = state.keyStates[u.id];\n        return ks === 'frozen' || ks === 'suspended';\n      }).map(u => ({ id: u.id, keyState: state.keyStates[u.id] })),\n      // 刀7 完整版：消费者名册与钥匙到位情况现量（⛔不下纸明文钥匙、⛔不下纸摘要——只报身份与政策）\n      consumers: [...consumerPolicy.values()].map(c => ({\n        id: c.id,\n        name: c.name,\n        enabled: c.enabled,\n        rpm: c.rpm,                       // null＝不限\n        rpd: c.rpd,\n        models: c.models || 'all',\n        upstreams: c.upstreams || 'all',\n        hasKey: c.id === LEGACY_CONSUMER_ID ? true : Object.values(KEYSTORE).includes(c.id), // false＝名册有政策但还没 --grant（⛔发钥匙给空气）\n        used: (() => { const s = consumerStats[c.id]; return s ? { win: s.winCount, day: s.dayCount } : null; })(),\n      })),\n      // 幽灵钥匙：库里有摘要、config 名册已删 ⇒ 出声（这些钥匙请求会拿 403 unregistered）\n      consumerGhostKeys: [...new Set(Object.values(KEYSTORE).filter(id => !consumerPolicy.has(id)))],\n      // 缺钥匙的消费者：要发钥匙得先 --grant\n      consumersMissingKey: [...consumerPolicy.values()].filter(c => c.id !== LEGACY_CONSUMER_ID && !Object.values(KEYSTORE).includes(c.id)).map(c => c.id),\n    }));\n    return;\n  }\n\n  // 刀7 完整版（2026-10-11 爸令「网关要给大家用」）：身份⛔再看 X-Henglin-Client——那只是一种「子标签」，\n  // 冒充不了身份、改不了限额归属（谁的头都记在「用哪把钥匙进来」的那本账下）。缺省 subTag=legacy。\n  // 声明放在白名单之前：没开的门也要留「谁敲的」这颗子标签（⛔为了读它把请求拖到鉴权之后＝TDZ 崩在此处）。\n  const clientTag = String(req.headers['x-henglin-client'] || 'legacy').replace(/[^a-zA-Z0-9_-]/g, '').slice(0, 40) || 'legacy';\n\n  // 业务面白名单＝这两条路径「按后缀」命中：兼容客户端自带前缀（如 /dsh/v1/chat/completions），\n  // 所以 /任意前缀/v1/models 也会放过——这是有意放宽，⛔当成安全边界（真正的门是下面那道鉴权＋限额）。\n  // /metrics（观测面）不在这条放宽里：它只认精确路径＋主钥匙。\n  const allowedPaths = ['/v1/chat/completions', '/v1/models'];\n  const isMetrics = reqUrl.pathname === '/metrics';\n  if (!isMetrics && !allowedPaths.some(p => reqUrl.pathname.endsWith(p))) {\n    res.writeHead(403, { 'Content-Type': 'application/json' });\n    res.end(JSON.stringify({ error: { type: 'path_not_allowed', message: 'henglin-gateway: 路径不在白名单（业务面只放 /v1/chat/completions、/v1/models）' } }));\n    // v0.8 收口补：这颗出口原先只回客户端、不落账 ⇒「谁在敲没开的门」查不到（与 5xx 补请求行同一口径）\n    logJSONL({ timestamp: nowIso(), subTag: clientTag, path: reqUrl.pathname, statusCode: 403, error: 'path_not_allowed' });\n    return;\n  }\n\n  // 鉴权：必须带本网关自己的钥匙\n  const authHeader = req.headers['authorization'] || '';\n  const presented = authHeader.startsWith('Bearer ') ? authHeader.slice(7).trim() : '';\n  // /metrics 只认主钥匙（消费者钥匙看不到全局账）\n  if (isMetrics && presented !== GATEWAY_KEY) {\n    res.writeHead(401, { 'Content-Type': 'application/json' });\n    res.end(JSON.stringify({ error: { type: 'invalid_api_key', message: 'henglin-gateway: /metrics 需主钥匙（node gateway.js --show-key）。' } }));\n    return;\n  }\n  if (isMetrics) {\n    res.writeHead(200, { 'Content-Type': 'text/plain; version=0.0.4; charset=utf-8' });\n    res.end(renderMetrics());\n    return;\n  }\n\n  // 身份＝钥匙说了算：主钥匙→legacy；消费者钥匙→摘要命中；都不是→ 401\n  const clientId = resolveIdentity(presented);\n  if (!clientId) {\n    res.writeHead(401, { 'Content-Type': 'application/json' });\n    res.end(JSON.stringify({\n      error: {\n        type: 'invalid_api_key',\n        message: 'henglin-gateway: 缺少或错误的 API Key。请在请求头带 Authorization: Bearer <恒林网关钥匙>（主钥匙：node gateway.js --show-key；消费者钥匙：node gateway.js --grant <id>）。',\n      },\n    }));\n    console.warn(`[${nowIso()}] 401 鉴权失败来自 ${req.headers.host || '?'} 路径 ${reqUrl.pathname}`);\n    metrics.unauthorized++; // 刀7 完整版：⛔身份也上指标（只计数、⛔记钥匙）\n    logJSONL({ timestamp: nowIso(), path: reqUrl.pathname, statusCode: 401, error: 'unauthorized', subTag: clientTag });\n    return;\n  }\n  const policy = consumerPolicyFor(clientId);\n  if (!policy) { // 库里有摘要、config 名册已删＝幽灵钥匙：出声拒发，⛔静默放行\n    res.writeHead(403, { 'Content-Type': 'application/json' });\n    res.end(JSON.stringify({ error: { type: 'consumer_unregistered', message: `henglin-gateway: 钥匙在册名册外（consumer=${clientId}）。请在 gateway.config.json 的 consumers[] 补政策。` } }));\n    logJSONL({ timestamp: nowIso(), clientId, subTag: clientTag, path: reqUrl.pathname, statusCode: 403, error: 'consumer_unregistered' });\n    return;\n  }\n  metricConsumer(clientId);\n\n  // 先收齐请求体（换线要重发，必须能重放）\n  const rawChunks = [];\n  req.on('data', chunk => rawChunks.push(chunk));\n  req.on('end', () => {\n    const rawBody = Buffer.concat(rawChunks);\n    const mc = metricConsumer(clientId);\n    mc.total++;\n    // 刀6 全局 10MB 顶 ＋ 刀7 完整版：每消费者可下调（maxBodyBytes 只许 ≤ 全局）\n    const bodyCap = policy.maxBodyBytes || DEFAULT_MAX_BODY_BYTES;\n    if (rawBody.length > bodyCap) {\n      mc.err++;\n      res.writeHead(413, { 'Content-Type': 'application/json' });\n      res.end(JSON.stringify({ error: { type: 'request_too_large', message: `henglin-gateway: 请求体超过本消费者上限 ${bodyCap} 字节（消费者=${clientId}）。` } }));\n      logJSONL({ timestamp: nowIso(), clientId, subTag: clientTag, path: reqUrl.pathname, statusCode: 413, error: 'request_too_large', bytes: rawBody.length, cap: bodyCap });\n      return;\n    }\n\n    // 先解一次体（只为打标与预检；解不动就按原样转发，与改前一致）\n","tool_call_id":"call_a22cd6c58ff84b72b775bc83"},{"role":"assistant","tool_calls":[{"id":"call_02be5f329342429f834c6697","type":"function","function":{"name":"read","arguments":"{\"limit\":150,\"line\":1770,\"path\":\"/Users/billtse/Desktop/泓家系统/恒林网关/gateway.js\"}"}}],"content":null},{"role":"tool","content":"    }\n\n    const maxAttempts = Math.min(MAX_ATTEMPTS_EFF, candidates.length);\n    const tried = [];\n    let lastResult = null;\n    let idx = 0;\n\n    const tryNext = () => {\n      if (idx >= maxAttempts) {\n        // 全都失败：把最后一次的真实错误语义回给客户端\n        console.warn(`[${nowIso()}] 全败（已试 ${tried.join(' → ')}）`);\n        mc.err++; // 刀7 完整版：消费者侧记「这一发请求最终没成」——一发只记一次，⛔按换线次数重复计数\n        // 刀15 全灭喊人：灾难事件行落账\n        logJSONL({ timestamp: nowIso(), event: 'allUpstreamsDown', clientId, attempted: tried.join(' → '), failureKind: (lastResult && lastResult.kind) || undefined, isStreamRequest: isStreamRequest });\n        if (!res.headersSent) {\n          const code = (lastResult && lastResult.statusCode && lastResult.statusCode >= 400) ? lastResult.statusCode : 502;\n          const detail = lastResult ? (lastResult.error || `upstream ${lastResult.statusCode}`) : 'unknown';\n          res.writeHead(code, { 'Content-Type': 'application/json' });\n          res.end(JSON.stringify({\n            error: {\n              type: 'all_upstreams_failed',\n              message: `henglin-gateway: 所有上游都失败了（试过 ${tried.join(', ')}）`,\n              detail,\n              failureKind: (lastResult && lastResult.kind) || undefined, // P1.1 ⑤：把最后一次的失败 kind 上抛客户端（对账/排障）\n              upstreams_tried: tried,\n            },\n          }));\n          // 刀7 完整版补账（同上，2026-10-12）：全败出口也要给消费者留一颗「这一发最终回了几」的请求行；\n          // 上游侧的失败是逐 attempt 行（一发的换线记录），两者口径不同、⛔互相顶替。\n          logJSONL({\n            timestamp: nowIso(),\n            clientId,\n            subTag: clientTag,\n            model: parsedBody?.model || 'unknown',\n            method: req.method,\n            path: reqUrl.pathname,\n            statusCode: code,\n            error: 'all_upstreams_failed',\n            failureKind: (lastResult && lastResult.kind) || undefined,\n            attempted: tried.join(' → '),\n            isStreamRequest,\n          });\n        }\n        return;\n      }\n\n      const upstream = candidates[idx];\n      idx++;\n\n      // P2.3：rpd 日配额预检——日限打满的腿本轮主动让位（不 +1、不发、不烧 429），试下一家\n      const dq = checkDailyQuota(upstream.id);\n      if (!dq.ok) {\n        lastResult = { ok: false, error: dq.reason, statusCode: 429 };\n        tried.push(`${upstream.id}(${dq.reason})`);\n        return tryNext();\n      }\n\n      if (!tryConsumeToken(upstream.id)) {\n        // 限流短路：该腿没真正发请求 → 不 +1（审核班 #4：避免限流腿 pending 虚高→normLoad 失真→永被排后=粘滞，重蹈 P1.1）\n        lastResult = { ok: false, error: 'rate-limited', statusCode: 429 };\n        tried.push(`${upstream.id}(限流)`);\n        return tryNext();\n      }\n      state.pending[upstream.id] = (state.pending[upstream.id] || 0) + 1; // P2.2：真正发请求才 in-flight +1（normLoad）\n      state.lastTrafficAt[upstream.id] = Date.now(); // 刀5：健康哨 idle 判据（真实流量刷新）\n\n      const bodyBuffer = parsedBody ? buildRequestBody(upstream, parsedBody) : rawBody;\n\n      attemptUpstream(upstream, req.method, reqUrl, req.headers, bodyBuffer, isStreamRequest ? { streamTo: res } : null).then(result => {\n        state.pending[upstream.id] = Math.max(0, (state.pending[upstream.id] || 0) - 1); // P2.2：该腿 attempt 已 settle（成功/失败/committed 透传都过这里）→ in-flight -1，防 pending 泄漏\n        if (result.ok) {\n          recordSuccess(upstream.id);\n          updateEWMA(upstream.id, result.durationMs);\n          console.log(`[${nowIso()}] ${req.method} ${reqUrl.pathname} → ${upstream.name} ${result.statusCode} (${result.durationMs}ms)`);\n\n          // 风格观测：非透传路径拿得到全文 ⇒ 体检后随成功行落账\n          let styleFlags;\n          let usage;\n          if (!result.committed) {\n            try {\n              const rj = JSON.parse(result.body.toString());\n              styleFlags = styleFlagsFor(rj.choices?.[0]?.message?.content);\n              usage = (rj.usage && typeof rj.usage === 'object') ? rj.usage : undefined; // 刀8：非流式 usage 抄账（上游响应 usage 字段不再丢弃）\n            } catch (e) { /* 非 JSON 响应，跳过体检 */ }\n          }\n\n          const mu = metricUpstream(upstream.id);\n          mu.ok++;\n          mc.ok++;\n          pushSample(mc.dur, result.durationMs);\n          if (result.ttftMs !== undefined) pushSample(mc.ttft, result.ttftMs);\n          else if (result.committed) pushSample(mc.ttft, result.durationMs); // 透传行＝首帧时刻（与台账同口径）\n          if (usage) {\n            mc.tokensIn += (typeof usage.prompt_tokens === 'number' ? usage.prompt_tokens : 0);\n            mc.tokensOut += (typeof usage.completion_tokens === 'number' ? usage.completion_tokens : 0);\n          }\n\n          logJSONL({\n            timestamp: nowIso(),\n            upstream: upstream.id,\n            clientId,             