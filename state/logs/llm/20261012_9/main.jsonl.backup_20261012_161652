dnight.getDate() + 1);\n  state.dailyCounters[u.id] = { used: 0, limit: Number.isFinite(u.rpd) && u.rpd > 0 ? u.rpd : Infinity, resetAt: _nextMidnight.getTime() };\n\n  // P1.3：同域派生（从 baseURL 取 host 分组，不硬编码腿 id；Agnes 两腿同 api.agnes-ai.cn）\n  try {\n    const host = new URL(u.baseURL).host;\n    if (!state.failureDomains[host]) state.failureDomains[host] = []; // 兼容写法（不用逻辑赋值运算符，保 Node 版本无关）\n    state.failureDomains[host].push(u.id);\n  } catch (e) { /* 异常 baseURL 跳过，不影响既有子表初始化 */ }\n\n  const rpm = u.rpm === Infinity ? 999 : (u.rpm || 10);\n  const ratePerSec = rpm / 60;\n  state.tokenBuckets[u.id] = {\n    tokens: ratePerSec * 60, // 初始满桶（60 秒容量，避免冷启动就限流）\n    maxTokens: ratePerSec * 60,\n---GATEWAY_KEY---\n362:const GATEWAY_KEY = ensureGatewayKey();\n540:  if (presented === GATEWAY_KEY) return LEGACY_CONSUMER_ID;\n1600:  if (isMetrics && presented !== GATEWAY_KEY) {\n2102:  console.log(GATEWAY_KEY);\n---persistCallSites---\n585:function persistConsumerStats() {\n764:function flushLogQueue() {\n1681:      if (verdict.reason === 'daily_quota_exceeded') persistConsumerStats(); // 日额度打满＝立刻落盘，重启不洗白\n1688:    if (verdict.next) persistConsumerStats();\n2001:  try { flushLogQueue(); } catch (_) { /* 落账失败也不遮退码 */ }\n2129:process.on('uncaughtException', (e) => {\n2133:    flushLogQueue();\n2137:process.on('unhandledRejection', (e) => {\n2146:  shuttingDown = true;\n2148:  flushLogQueue(); // P1.2：退出前把台账队列同步落盘，不丢最后一批账\n2149:  persistConsumerStats(); // 刀7 完整版：退出前落消费者额度账（⛔重启＝白送一次额度重置）\n2156:    try { flushLogQueue(); persistConsumerStats(); } catch (_) {} // 排水期可能还有新账/新额度，再落一次\n2161:process.on('SIGTERM', () => gracefulShutdown('SIGTERM'));\n2163:process.on('SIGINT', () => gracefulShutdown('SIGINT'));\n---polling?---\n228:    const doc = JSON.parse(fs.readFileSync(CONFIG_PATH, 'utf8'));\n---streamcap---\n      if (opts && opts.streamTo && proxyRes.statusCode < 400 && isSSE) {\n        const res = opts.streamTo;\n        res.writeHead(proxyRes.statusCode, relayHeaders(proxyRes.headers));\n        let firstChunkSeen = false;\n        let streamBytes = 0; // P2.4 流式体量顶：逐块 res.write 不缓存全量，但超 cap 要干净断流（防超大 SSE 流灌爆客户端连接）\n        let streamCapped = false;\n        const STREAM_BYTE_CAP = 5_000_000; // P2.4：与非流式 RESP_BYTE_CAP 同 5MB（LLM 正常流远小于此，13.3M 异常体才触发）\n        let usageMatch = null; // 刀8：SSE 帧旁路抓最后一个 usage 对象（帧原样转发消费者零感知，这里只抄账）\n        // 刀10：块间空闲 60s 计时器（每帧重置）——上游僵死不再永久挂（F6 洞收口；15s 心跳管「客户端侧」、本计时器管「上游侧」）\n        const idleTimer = setInterval(() => {\n          console.warn(`[${nowIso()}] ${upstream.id} 透传块间空闲 >60s，断流落账`);\n          try { res.write(': stream_stall\\n\\n'); res.end(); } catch (_) { /* 已断 */ }\n          try { proxyRes.destroy(); } catch (_) { /* 已断 */ }\n          logJSONL({ timestamp: nowIso(), upstream: upstream.id, statusCode: proxyRes.statusCode, streamStall: 'idle_60s', isStreamRequest: true });\n        }, 60000);\n        idleTimer.unref();\n        proxyRes.on('data', (chunk) => {\n          idleTimer.refresh(); // 刀10：每帧重置空闲计时\n          if (!usageMatch) { // 刀8：旁路扫 usage 尾帧（flat 对象；嵌套字段 parse 失败跳过不挡转发）\n            const m = chunk.toString().match(/\"usage\"\\s*:\\s*(\\{[^}]*\\})/);\n            if (m) usageMatch = m[1];\n          }\n          streamBytes += chunk.length;\n          if (streamBytes > STREAM_BYTE_CAP && !streamCapped) {\n            // P2.4：超 5MB → 已 commit 不能换腿，发合法 SSE 终止帧 + 干净断流（客户端不挂死、不内存爆）\n            streamCapped = true;\n            try { res.write(': stream_too_large\\n\\n'); } catch (_) { /* 已断 */ }\n            try { res.end(); } catch (_) { /* 已断 */ }\n            proxyRes.destroy();\n            logJSONL({ timestamp: nowIso(), upstream: upstream.id, statusCode: 200, streamStall: 'too_large', bytes: streamBytes, isStreamRequest: true });\n            return;\n          }\n          if (!firstChunkSeen) {\n            firstChunkSeen = true;\n            proxyReq.setTimeout(0); // 首帧后关掉 socket 超时：长回答不再被 25s 切断\n            resolve({ ok: true, committed: true, statusCode: proxyRes.statusCode, durationMs: Date.now() - start });\n          }\n          if (!streamCapped) res.write(chunk); // 正常写（超 cap 后不再写后续帧）\n        });\n        proxyRes.on('end', () => {\n          if (!firstChunkSeen) {\n---nostream cap---\n\n      const chunks = [];\n      let respBytes = 0; // P1.2 出向 5MB 体量顶（洞②：非流式收全量前设 cap，防超大 500 体撑爆内存）\n      const RESP_BYTE_CAP = 5_000_000;\n      let firstByteMs = null; // 刀8 增量：非流式路径自量「上游首字节时刻」——真读数，⛔拿 durationMs（整包时刻）顶替\n      proxyRes.on('data', c => {\n        if (firstByteMs === null) firstByteMs = Date.now() - start; // 首块到达即记，后续块不覆写\n        respBytes += c.length;\n        if (respBytes > RESP_BYTE_CAP) {\n          proxyRes.destroy(); // 立即断开上游，不再收后续帧\n          resolve({ ok: false, error: 'response_too_large', statusCode: 0, durationMs: Date.now() - start });\n          return;\n        }\n        chunks.push(c);\n      });\n      proxyRes.on('end', () => {\n        if (respBytes > RESP_BYTE_CAP) return; // 已被 data 分支顶过、resolve 过，不重复\n        resolve({\n          ok: proxyRes.statusCode < 400,\n          statusCode: proxyRes.statusCode,\n          headers: proxyRes.headers,\n          body: Buffer.concat(chunks),\n          durationMs: Date.now() - start,\n          // 刀8 增量：非流式/重试成功行也带 ttftMs（口径＝上游首字节，非首 token——非流式看不到 token 边界）。\n          // 空体响应（无 data 事件）＝没量到 → undefined 不落字段，⛔镀成 0 或 durationMs。\n          ttftMs: firstByteMs === null ? undefined : firstByteMs,\n        });\n      });\n      proxyRes.on('error', (e) => {\n        resolve({ ok: false, error: `response error: ${e.message}`, statusCode: 0, durationMs: Date.now() - start });\n      });\n    });\n\n    proxyReq.on('error', (e) => {\n      resolve({ ok: false, error: e.message, statusCode: 0, durationMs: Date.now() - start });\n    });\n\n    proxyReq.on('timeout', () => {\n      proxyReq.destroy();\n      resolve({ ok: false, error: 'timeout', statusCode: 0, durationMs: Date.now() - start });\n    });\n\n    if (bodyBuffer.length > 0) proxyReq.write(bodyBuffer);