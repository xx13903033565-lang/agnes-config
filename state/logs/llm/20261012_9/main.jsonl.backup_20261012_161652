     }\n          retryAfterMs = resetMs;\n          state.lastRateLimitReset[upstream.id] = Date.now() + resetMs;\n        }\n\n        console.warn(`[${nowIso()}] ${upstream.name} 失败(${result.statusCode || result.error}, ${cls.kind}${retryAfterMs ? `, 退避 ${retryAfterMs}ms` : ''}) → ${cls.retryable === false ? '短路(不可重试)' : '换线重试'}`);\n        metricUpstream(upstream.id).fail++; // 刀7 完整版：上游侧记「尝试颗数」（一发请求可能烧三腿⇒腿账按次、消费者账按发⛔混）\n        logJSONL({\n          timestamp: nowIso(),\n          upstream: upstream.id,\n          clientId,           // 刀7 完整版：身份＝钥匙给的\n          client: clientTag,  // 刀7：子标签\n          model: parsedBody?.model || 'unknown',\n          method: req.method,\n          path: reqUrl.pathname,\n          statusCode: result.statusCode,\n          error: result.error,\n          failureKind: cls.kind,\n          retryable: cls.retryable,\n          shortCircuited: cls.retryable === false || undefined, // P1.1 ④：对账\n          retryAfterMs: retryAfterMs || undefined,             // P1.1 ④：对账\n          rateHeaders: selectRateHeaders(result.headers),      // P1.6：脱敏留证（429/403 自然出现时抓 Retry-After/X-RateLimit*/X-AGNES*，不存全量/auth）\n          durationMs: result.durationMs,\n          isStreamRequest,\n          failoverFrom: tried.length > 1 ? tried[tried.length - 2] : undefined,\n        });\n\n        // P1.1 ①：gate 短路——不可重试（auth/payment/context_window/bad_request）不换腿，跳全败出口回 502 带 kind\n        lastResult = { ...result, kind: cls.kind }; // P1.1 ③：kind 附着到 lastResult，让全败出口 :713 带 kind\n        if (cls.retryable === false) {\n          console.warn(`[${nowIso()}] ${cls.kind} 不可重试，短路跳全败出口`);\n          // 走全败出口：守卫是 idx>=maxAttempts（maxAttempts=min(MAX_ATTEMPTS_EFF,candidates.length)），\n          // 顶 idx=candidates.length 恒 ≥ maxAttempts，必触发出口回 502 带 kind\n          idx = candidates.length;\n          return tryNext();\n        }\n        tryNext();\n===ensureGatewayKey===\n}\n\nfunction ensureGatewayKey() {\n  // ① credentials 里已有\n  const fromCreds = creds[G