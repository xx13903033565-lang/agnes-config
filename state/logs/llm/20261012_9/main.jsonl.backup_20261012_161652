dnight.getDate() + 1);\n  state.dailyCounters[u.id] = { used: 0, limit: Number.isFinite(u.rpd) && u.rpd > 0 ? u.rpd : Infinity, resetAt: _nextMidnight.getTime() };\n\n  // P1.3：同域派生（从 baseURL 取 host 分组，不硬编码腿 id；Agnes 两腿同 api.agnes-ai.cn）\n  try {\n    const host = new URL(u.baseURL).host;\n    if (!state.failureDomains[host]) state.failureDomains[host] = []; // 兼容写法（不用逻辑赋值运算符，保 Node 版本无关）\n    state.failureDomains[host].push(u.id);\n  } catch (e) { /* 异常 baseURL 跳过，不影响既有子表初始化 */ }\n\n  const rpm = u.rpm === Infinity ? 999 : (u.rpm || 10);\n  const ratePerSec = rpm / 60;\n  state.tokenBuckets[u.id] = {\n    tokens: ratePerSec * 60, // 初始满桶（60 秒容量，避免冷启动就限流）\n    maxTokens: ratePerSec * 60,\n---GATEWAY_KEY---\n362:const GATEWAY_KEY = ensureGatewayKey();\n540:  if (presented === GATEWAY_KEY) return LEGACY_CONSUMER_ID;\n1600:  if (isMetrics && presented !== GATEWAY_KEY) {\n2102:  console.log(GATEWAY_KEY);\n---persistCallSites---\n585:function persistConsumerStats() {\n764:function flushLogQueue() {\n1681:      if (verdict.reason === 'daily_quota_exceeded') persistConsumerStats(); // 日额度打满＝立刻落盘，重启不洗白\n1688:    if (verdict.next) persistConsumerStats();\n2001:  try { flushLogQueue(); } catch (_) { /* 落账失败也不遮退码 */ }\n2129:process.on('uncaughtException', (e) => {\n2133:    flushLogQueue();\n2137:process.on('unhandledRejection', (e) => {\n2146:  shuttingDown = true;\n2148:  flushLogQueue(); // P1.2：退出前把台账队列同步落盘，不丢最后一批账\n2149:  persistConsumerStats(); // 刀7 完整版：退出前落消费者额度账（⛔重启＝白送一次额度重置）\n2156:    try { flushLogQueue(); persistConsumerStats(); } catch (_) {} // 排水期可能还有新账/新额度，再落一次\n2161:process.on('SIGTERM', () => gracefulShutdown('SIGTERM'));\n2163:process.on('SIGINT', () => gracefulShutdown('SIGINT'));\n---polling?---\n228:    const doc = JSON.parse(fs.readFileSync(CONFIG_PATH, 'utf8'));\n---streamcap---\n      if (opts && opts.streamTo && proxyRes.statusCode < 400 && isSSE) {\n        const res = opts.streamTo;\n        res.writeHead(proxyRes.statusCode, relayHeaders(proxyRes.h