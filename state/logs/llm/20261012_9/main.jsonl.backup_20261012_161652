lGraphNode"},"default":[]}},"$defs":{"ToolGraphNode":{"type":"object","properties":{"tool":{"description":"Tool name in format \"server/tool\" (e.g., \"developer/shell\")","type":"string"},"description":{"description":"Brief description of what this call does (e.g., \"list files in /src\")","type":"string"},"depends_on":{"description":"Indices of nodes this depends on (empty if no dependencies)","type":"array","items":{"type":"integer","format":"uint","minimum":0},"default":[]}},"required":["tool","description"]}},"required":[]}}},{"type":"function","function":{"name":"get_function_details","description":"Get detailed TypeScript definitions for specific functions.\n\nProvide function names in 'namespace.functionName' format (e.g., 'Notion.apiPostSearch').\nReturns full type signatures, parameter schemas, and return types.\n\nNote: Functions showing Promise<any> return type have no schema - the actual runtime\nvalue is a parsed JavaScript object (never a JSON string).","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"GetFunctionDetailsInput","type":"object","properties":{"functions":{"description":"List of functions to get details of.","type":"array","items":{"$ref":"#/$defs/FunctionId"}}},"required":["functions"],"$defs":{"FunctionId":{"description":"Function representation in the form should be in the form '<namespace>.<function name>'. e.g. If there is a function `getData` within the `DataApi` namespace the value provided in this field is DataApi.getData","type":"string"}}}}},{"type":"function","function":{"name":"image_search","description":"Search for and locally verify web images. Prefer explicitly requested or configured image tools. Batch multiple subjects. Do not publish candidates as user-facing artifacts unless the user asked to see or save the images. For reports, slides, HTML, or other documents set source_material=true.","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ImageSearchParams","type":"object","properties":{"query":{"description":"Concise image query. Optional when `queries` is provided.","type":"string","default":""},"queries":{"description":"Multiple image queries in one call (internally parallel). Prefer this when several subjects need images.","type":"array","items":{"type":"string"},"default":[]},"source_material":{"description":"True when the images are internal source material for another artifact. Forces publish_artifacts=false.","type":"boolean","default":false},"publish_artifacts":{"description":"Register verified images as user-facing artifacts. Defaults to true for direct image search requests. Set false, or set source_material=true, when gathering pictures for a report, slide, HTML page, or other document.","type":"boolean","default":true},"provider":{"description":"Optional provider: auto, bff, searchfree, searxng, or duckduckgo.","type":"string","default":null},"max_results":{"description":"Maximum images to return. Defaults to 8, capped at 20.","type":"integer","format":"uint","minimum":0,"default":null},"region":{"description":"DuckDuckGo/SearXNG region, for example us-en, wt-wt, uk-en, cn-zh.","type":"string","default":null},"safe_search":{"description":"Safe search setting: strict, moderate, or off.","type":"string","default":null},"size":{"description":"Optional image size hint: small, medium, large, wallpaper.","type":"string","default":null},"image_type":{"description":"Optional image type hint: photo, clipart, gif, transparent.","type":"string","default":null},"include_domains":{"description":"Restrict image source pages to these domains.","type":"array","items":{"type":"string"},"default":[]},"exclude_domains":{"description":"Exclude image source pages from these domains.","type":"array","items":{"type":"string"},"default":[]}},"required":[]}}},{"type":"function","function":{"name":"list_functions","description":"List all available SDK functions organized by namespace.\n\nReturns function signatures showing structure without full type details.","parameters":{"type":"object","properties":{},"required":[]}}},{"type":"function","function":{"name":"load","description":"List or load recipes, agents, and subrecipes, and inspect background tasks. With a task ID, wait by default; use peek to poll or cancel to stop it.","parameters":{"type":"object","properties":{"source":{"type":"string","description":"Name of the source to load. If omitted, lists all available sources."},"cancel":{"type":"boolean","default":false,"description":"For running background tasks: cancel and return output."},"peek":{"type":"boolean","default":false,"description":"For running background tasks: check progress without blocking. Returns turn count, idle time, and recent tool activity."}},"required":[]}}},{"type":"function","function":{"name":"load_skill","description":"Load a skill's full content into your context so you can follow its instructions.\n\nSkills are listed in your system instructions. When you need to use one, load it first to get the detailed instructions.\n\nExamples:\n- load_skill(name: \"gdrive\") → Loads the gdrive skill instructions\n- load_skill(name: \"my-skill\", args: \"the arguments for the skill\") → Loads a skill with arguments\n- load_skill(name: \"my-skill/template.md\") → Loads a supporting file","parameters":{"type":"object","required":["name"],"properties":{"name":{"type":"string","description":"Name of the skill to load. Use \"skill-name/path\" to load a supporting file."},"args":{"type":"string","description":"Optional arguments to provide when loading the skill."}}}}},{"type":"function","function":{"name":"read","description":"Fallback UTF-8 text-file reader when shell fails or is unavailable. You MUST try shell first. Do not use it for binary formats such as PDF, DOCX, or XLSX; use a matching extension tool instead. Accepts absolute paths, including files outside the current workspace when the user provides them. Optionally start at a 1-based line and limit how many lines are ret