ast.Return) and isinstance(n.value, ast.IfExp):\n            used.update(_int_literals(n.value))\n    doc = ast.get_docstring(tree) or ''\n    i = doc.find('退码')\n    # 只扫「退码」那一小节，行内并列的几档都要收到（⛔只认行首那颗＝漏档还会假装对平）\n    declared = {int(m.group(1)) for m in re.finditer(r'(?<![\\d.])(\\d+)=', doc[i:])} if i >= 0 else set()\n    return used, declared\n\n\ndef selftest():\n    \"\"\"自检腿一览见下方 name_ok 调用（真数据出建议／归一校验／夹幅／样本不足闸／全同因子／空台账／缺因子／坏行不吞／退码档位对拉）；\n    颗数与 PASS 数只由 results 现算打印，⛔在注释里手钉。\"\"\"\n    import tempfile\n    here = os.path.dirname(os.path.abspath(__file__))\n    base_cfg = json.load(open(os.path.join(here, 'gateway.config.json'), encoding='utf-8'))\n    results = []\n\n    def name_ok(n, ok, detail):\n        results.append((n, bool(ok)))\n        print(f\"  [{'PASS' if ok else 'FAIL'}] {n}：{detail}\")\n\n    def mk(cfg, rows):\n        d = tempfile.mkdtemp(prefix='hl_cal_')\n        cp = os.path.join(d, 'gateway.config.json')\n        json.dump(cfg, open(cp, 'w', encoding='utf-8'), ensure_ascii=False)\n        lp = os.path.join(d, 'logs')\n        os.makedirs(lp, exist_ok=True)\n        with open(os.path.join(lp, 'requests.jsonl'), 'w', encoding='utf-8') as f:\n            for r in rows:\n                f.write(json.dumps(r, ensure_ascii=False) + '\\n')\n        return cp, os.path.join(lp, 'requests.jsonl')\n\n    def audit_item(lid, lat=0.5, hlth=1.0, cost=1.0, load=1.0, size=1.0, prio=0.5, pen=1):\n        return {'upstream': lid, 'penalty': pen,\n                'factors': {'lat': lat, 'hlth': hlth, 'cost': cost, 'load': load, 'size': size, 'prio': prio}}\n\n    def row(up, dur, code=200, ttft=None, aud=None, attempted=None):\n        r = {'timestamp': '2026-10-11T00:00:00.000Z', 'upstream': up, 'statusCode': code,\n             'durationMs': dur, 'isStreamRequest': False, 'routingAudit': aud or []}\n        if ttft is not None:\n            r['ttftMs'] = ttft\n        if attempted is not None:\n            r['attempted'] = attempted\n        return r\n\n    cfg2 = dict(base_cfg)\n    cfg2['upstreams'] = [{'id': 'A', 'maxOutputTokens': 4096, 'bias': 1.0},\n                         {'id': 'B', 'maxOutputTokens': 4096, 'bias': 1.0}]\n    rows_many = []\n    for i in range(60):\n        # A 快且稳；B 慢且偶发失败；lat 因子与结果同向 ⇒ 建议应把 lat 抬起来\n        if i % 5 == 4:\n            rows_many.append(row('B', 1800 + i * 3, aud=[audit_item('A', lat=0.8), audit_item('B', lat=0.2)],\n                                 attempted=['A', ]))\n            rows_many.append(row('A', 300 + i, aud=[audit_item('A', lat=0.8), audit_item('B', lat=0.2)],\n                                 attempted=['B(500)', 'A']))","tool_call_id":"call_5acaf766c45943f28c8be479"},{"role":"user","content":"<turn-context>\n<current-time>2026-10-12 09:53:00 +08:00</current-time>\n<working-directory>/Users/billtse/Desktop/泓家系统/恒林网关</working-directory>\n\nALWAYS batch multiple tool operations into ONE execute_typescript call, except agnes_artifacts__present_artifacts, which must be called directly.\n- WRONG: Separate execute_typescript calls for read file, then write file\n- RIGHT: One execute_typescript with an async run() function that reads AND writes AND logs/returns as little information as needed for the next step.\n\n73 callback functions are available only from inside execute_typescript. Do not call callback function names directly as tools. Use list_functions and get_function_details to inspect signatures before writing one execute_typescript call.\n\n\nCurrent tasks and notes:\nOnce given a task, immediately update your todo with all explicit and implicit requirements. Complete every TODO update before starting the final user-facing response, and never call a TODO tool after the final response has started.\n\n\n# 每回合规矩（爱思办公 · 电商工作台）\n\n> 这段由 `AGNES_MOIM_MESSAGE_FILE` 每轮注入，每多一行每次请求就多背一行 ⇒ 只留「反复出错的」和「不能商量的」。\n> 引擎自己已经在 `<turn-context>` 里写了「批量进一次 execute_typescript」「先 list_functions/get_function_details 再写」，这里⛔重复那两句。\n\n## Code Mode（本机那批 TS 白跑换来的四条；颗数由 `agent_perf.py --ch